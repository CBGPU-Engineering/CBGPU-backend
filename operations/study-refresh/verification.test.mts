import test from'node:test';import assert from'node:assert/strict';import{EventEmitter}from'node:events';import{verificationObserver,waitForNormalVerification,VerificationError,type VerificationSnapshot}from'./verification.mts';
const base:VerificationSnapshot={sdk_responses:1,sdk_http_error:null,sdk_request_failures:0,challenge_request_failures:0,page_errors:0,browser_connected:true,sdk_api_present:true,response_field_present:true,response_ready:false,widget_frame_present:true};
function page(){const p=new EventEmitter()as any;p.connected=true;p.dom={sdk_api_present:true,response_field_present:true,response_ready:false};p.browser=()=>({isConnected:()=>p.connected});p.frames=()=>[{url:()=> 'https://challenges.cloudflare.com/cdn-cgi/challenge-platform/private?secret=never-log'}];p.evaluate=async()=>p.dom;p.waitForFunction=async()=>{if(!p.dom.response_ready)throw Error('timeout contains private input not logged')};return p;}
test('SDK and challenge failures cannot be mislabeled as human verification',async()=>{for(const kind of['SDK','CHALLENGE']){const p=page(),o=verificationObserver(p);p.emit('requestfailed',{url:()=>kind==='SDK'?'https://challenges.cloudflare.com/turnstile/v0/api.js?credential=private':'https://challenges.cloudflare.com/cdn-cgi/challenge-platform/private?token=private'});await assert.rejects(waitForNormalVerification(p,o,1),(e:any)=>e instanceof VerificationError&&e.message==='verification_network_failed'&&!JSON.stringify(e.diagnostic).includes('private'));o.close();assert.equal(p.listenerCount('requestfailed'),0)}});
test('normal pending, missing widget, script HTTP error and browser crash stay distinct without claiming a solvable human check',async()=>{for(const [patch,reason]of[[{},'verification_not_completed'],[{dom:{sdk_api_present:false,response_field_present:false,response_ready:false}},'verification_widget_unavailable'],[{connected:false},'verification_browser_unavailable']]as const){const p=Object.assign(page(),patch),o=verificationObserver(p);await assert.rejects(waitForNormalVerification(p,o,1),(e:any)=>e.message===reason);o.close()}const p=page(),o=verificationObserver(p);p.emit('response',{url:()=> 'https://challenges.cloudflare.com/turnstile/v0/api.js',status:()=>503});await assert.rejects(waitForNormalVerification(p,o,1),(e:any)=>e.message==='verification_network_failed');o.close()});
test('successful normal managed response only waits; diagnostics never return its value or foreign URLs',async()=>{const p=page(),o=verificationObserver(p);p.dom.response_ready=true;p.emit('response',{url:()=> 'https://challenges.cloudflare.com/turnstile/v0/api.js',status:()=>200});p.emit('requestfailed',{url:()=> 'https://not-cloudflare.invalid/private?password=private'});await waitForNormalVerification(p,o,1);const s=await o.snapshot();assert.deepEqual(s,{...base,response_ready:true});assert.ok(!JSON.stringify(s).includes('private'));for(let i=0;i<100;i++)p.emit('pageerror',Error('private-credentials'));assert.equal((await o.snapshot()).page_errors,8);o.close()});
