/** Observe only the site's normal managed verification. Never intercept requests, solve a challenge, or expose URLs/response values. */
type PageLike={on:(event:string,handler:(value:any)=>void)=>unknown;off:(event:string,handler:(value:any)=>void)=>unknown;frames:()=>{url:()=>string}[];browser:()=>{isConnected:()=>boolean};evaluate:(fn:()=>unknown)=>Promise<any>;waitForFunction:(fn:()=>boolean,options:{timeout:number})=>Promise<unknown>};
export type VerificationSnapshot={sdk_responses:number;sdk_http_error:number|null;sdk_request_failures:number;challenge_request_failures:number;page_errors:number;browser_connected:boolean;sdk_api_present:boolean;response_field_present:boolean;response_ready:boolean;widget_frame_present:boolean};
const challenge=(raw:string)=>{try{const u=new URL(raw);return u.protocol==='https:'&&u.hostname==='challenges.cloudflare.com'?/^\/turnstile\/v\d+\/api\.js$/.test(u.pathname)?'SDK':'CHALLENGE':null}catch{return null}};
export function verificationObserver(page:PageLike){
 const state={sdk_responses:0,sdk_http_error:null as number|null,sdk_request_failures:0,challenge_request_failures:0,page_errors:0};const capped=(n:number)=>Math.min(8,n+1);
 const response=(r:any)=>{if(challenge(r.url())!=='SDK')return;state.sdk_responses=capped(state.sdk_responses);const status=r.status();if(status<200||status>=400)state.sdk_http_error=Number.isInteger(status)&&status>=100&&status<=599?status:0};
 const failed=(r:any)=>{const kind=challenge(r.url());if(kind==='SDK')state.sdk_request_failures=capped(state.sdk_request_failures);else if(kind==='CHALLENGE')state.challenge_request_failures=capped(state.challenge_request_failures)};
 const pageError=()=>{state.page_errors=capped(state.page_errors)};
 page.on('response',response);page.on('requestfailed',failed);page.on('pageerror',pageError);
 return{async snapshot():Promise<VerificationSnapshot>{let connected=false,dom={sdk_api_present:false,response_field_present:false,response_ready:false},widget=false;try{connected=page.browser().isConnected();if(connected){dom=await page.evaluate(()=>{const f=document.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');return{sdk_api_present:typeof(window as unknown as {turnstile?:unknown}).turnstile==='object',response_field_present:!!f,response_ready:!!f?.value}});widget=page.frames().some(f=>!!challenge(f.url()))}}catch{connected=false}return{...state,browser_connected:connected,...dom,widget_frame_present:widget}},close(){page.off('response',response);page.off('requestfailed',failed);page.off('pageerror',pageError)}};
}
export function verificationFailure(s:VerificationSnapshot){if(!s.browser_connected)return'verification_browser_unavailable';if(s.sdk_request_failures||s.challenge_request_failures||s.sdk_http_error!==null)return'verification_network_failed';if(s.page_errors)return'verification_page_failed';if(!s.sdk_api_present||!s.response_field_present||!s.widget_frame_present)return'verification_widget_unavailable';return'verification_not_completed';}
export class VerificationError extends Error{readonly diagnostic:VerificationSnapshot;constructor(diagnostic:VerificationSnapshot){super(verificationFailure(diagnostic));this.diagnostic=diagnostic;}}
export async function waitForNormalVerification(page:PageLike,observer:ReturnType<typeof verificationObserver>,timeout=25000){try{await page.waitForFunction(()=>!!document.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value,{timeout})}catch{throw new VerificationError(await observer.snapshot())}}
