[Unit]
Description=CBGPU Rust opt-in weekday self-study trigger
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=%h/.local/lib/cbgpu-rust/current/cbgpu-core study-auto
EnvironmentFile=%h/.config/cbgpu/rust-core.env
TimeoutStartSec=180s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
TasksMax=32
