import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import os from'node:os';import path from'node:path';import crypto from'node:crypto';import{DatabaseSync}from'node:sqlite';import{legacyDatabasePath}from'./legacy-database.mts';
test('default remains unchanged; explicit new reverse file requires real AEAD and byte/root proof',()=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-reverse-node-'));fs.chmodSync(dir,0o700);const original=path.join(dir,'deploy.sqlite'),next=path.join(dir,'new.sqlite'),key=Buffer.alloc(32,7);fs.writeFileSync(original,'original marker',{mode:0o600});const db=new DatabaseSync(next);db.exec('CREATE TABLE projects(id TEXT PRIMARY KEY)');db.close();fs.chmodSync(next,0o600);const originalBytes=fs.readFileSync(original);let manifest:any={format:1,source_fingerprint:'a'.repeat(64),native_data_root:dir,sqlite_sha256:crypto.createHash('sha256').update(fs.readFileSync(next)).digest('hex')};const write=()=>{const nonce=crypto.randomBytes(12),cipher=crypto.createCipheriv('aes-256-gcm',key,nonce),body=Buffer.concat([cipher.update(JSON.stringify(manifest)),cipher.final()]);fs.writeFileSync(next+'.manifest.json',JSON.stringify({format:'cbgpu-deploy-reverse-v1',sealed_manifest:Buffer.concat([nonce,body,cipher.getAuthTag()]).toString('base64')}),{mode:0o600})};const unseal=(value:string)=>{const bytes=Buffer.from(value,'base64'),decipher=crypto.createDecipheriv('aes-256-gcm',key,bytes.subarray(0,12));decipher.setAuthTag(bytes.subarray(-16));return JSON.parse(Buffer.concat([decipher.update(bytes.subarray(12,-16)),decipher.final()]).toString())};try{assert.equal(legacyDatabasePath(undefined,original,()=>{throw Error('unused')}),original);assert.throws(()=>legacyDatabasePath('',original,unseal));write();assert.equal(legacyDatabasePath(next,original,unseal,'a'.repeat(64)),next);manifest.source_fingerprint='b'.repeat(64);write();assert.throws(()=>legacyDatabasePath(next,original,unseal,'a'.repeat(64)),/Stale reverse/);manifest.source_fingerprint='a'.repeat(64);manifest.native_data_root='/different';write();assert.throws(()=>legacyDatabasePath(next,original,unseal,'a'.repeat(64)),/artifact-root/);manifest.native_data_root=dir;write();const envelope=JSON.parse(fs.readFileSync(next+'.manifest.json','utf8'));const bytes=Buffer.from(envelope.sealed_manifest,'base64');bytes[15]^=1;envelope.sealed_manifest=bytes.toString('base64');fs.writeFileSync(next+'.manifest.json',JSON.stringify(envelope));assert.throws(()=>legacyDatabasePath(next,original,unseal,'a'.repeat(64)));write();fs.appendFileSync(next,'tampered');assert.throws(()=>legacyDatabasePath(next,original,unseal,'a'.repeat(64)),/hash differs/);assert.deepEqual(fs.readFileSync(original),originalBytes)}finally{fs.rmSync(dir,{recursive:true,force:true})}});
test('authenticated activation allows legitimate SQLite writes across restarts, but not forged or copied activation identity',()=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-reverse-active-'));fs.chmodSync(dir,0o700);const original=path.join(dir,'deploy.sqlite'),next=path.join(dir,'new.sqlite'),key=Buffer.alloc(32,7),fingerprint='c'.repeat(64);fs.writeFileSync(original,'preserved original',{mode:0o600});const database=new DatabaseSync(next);database.exec('CREATE TABLE projects(id TEXT PRIMARY KEY)');database.close();fs.chmodSync(next,0o600);const seal=(value:any)=>{const nonce=crypto.randomBytes(12),cipher=crypto.createCipheriv('aes-256-gcm',key,nonce);const bytes=Buffer.concat([cipher.update(JSON.stringify(value)),cipher.final()]);return Buffer.concat([nonce,bytes,cipher.getAuthTag()]).toString('base64')},unseal=(value:string)=>{const bytes=Buffer.from(value,'base64'),decipher=crypto.createDecipheriv('aes-256-gcm',key,bytes.subarray(0,12));decipher.setAuthTag(bytes.subarray(-16));return JSON.parse(Buffer.concat([decipher.update(bytes.subarray(12,-16)),decipher.final()]).toString())};fs.writeFileSync(next+'.manifest.json',JSON.stringify({format:'cbgpu-deploy-reverse-v1',sealed_manifest:seal({format:1,source_fingerprint:fingerprint,native_data_root:dir,sqlite_sha256:crypto.createHash('sha256').update(fs.readFileSync(next)).digest('hex')})}),{mode:0o600});try{assert.equal(legacyDatabasePath(next,original,unseal,fingerprint,seal),next);assert.equal(fs.statSync(next+'.activation.json').mode&0o077,0);const active=new DatabaseSync(next);active.exec("INSERT INTO projects VALUES('legitimate-new-write')");active.close();assert.equal(legacyDatabasePath(next,original,unseal,fingerprint,seal),next);const reopened=new DatabaseSync(next);assert.equal((reopened.prepare('SELECT id FROM projects').get()as any).id,'legitimate-new-write');reopened.close();const copied=path.join(dir,'copied.sqlite');fs.copyFileSync(next,copied);fs.copyFileSync(next+'.manifest.json',copied+'.manifest.json');fs.copyFileSync(next+'.activation.json',copied+'.activation.json');assert.throws(()=>legacyDatabasePath(copied,original,unseal,fingerprint,seal),/identity differs/);const receipt=JSON.parse(fs.readFileSync(next+'.activation.json','utf8'));const damaged=Buffer.from(receipt.sealed_receipt,'base64');damaged[15]^=1;fs.writeFileSync(next+'.activation.json',JSON.stringify({...receipt,sealed_receipt:damaged.toString('base64')}));assert.throws(()=>legacyDatabasePath(next,original,unseal,fingerprint,seal));receipt.sealed_receipt=seal({format:1,path:next,device:'wrong',inode:'wrong',source_fingerprint:fingerprint,initial_hash:'wrong'});fs.writeFileSync(next+'.activation.json',JSON.stringify(receipt));assert.throws(()=>legacyDatabasePath(next,original,unseal,fingerprint,seal),/identity differs/);assert.equal(fs.readFileSync(original,'utf8'),'preserved original')}finally{fs.rmSync(dir,{recursive:true,force:true})}});
