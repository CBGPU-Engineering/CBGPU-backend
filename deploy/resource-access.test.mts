import test from'node:test';import assert from'node:assert/strict';import{deploymentResourceEnforced,ownerCanExecute}from'./resource-access.mts';
test('true,1,multischool and malformed flags enforce the resource oracle; only absent/explicit disabled preserve legacy',()=>{for(const env of[{CBGPU_ACCOUNT_V2:'true'},{CBGPU_ACCOUNT_V2:'1'},{CBGPU_MULTISCHOOL_V1:'1'},{CBGPU_ACCOUNT_V2:'false',CBGPU_MULTISCHOOL_V1:'true'},{CBGPU_ACCOUNT_V2:'tru'},{CBGPU_MULTISCHOOL_V1:'bad'},{CBGPU_ACCOUNT_V2:' FALSE '},{CBGPU_MULTISCHOOL_V1:'FALSE'},{CBGPU_ACCOUNT_V2:'0 '}])assert.equal(deploymentResourceEnforced(env),true);for(const env of[{}, {CBGPU_ACCOUNT_V2:'false'},{CBGPU_ACCOUNT_V2:'0',CBGPU_MULTISCHOOL_V1:'false'}])assert.equal(deploymentResourceEnforced(env),false)});
test('scope false, nonboolean replies, missing secret and outage never authorize execution',async()=>{const keys=['CBGPU_ACCOUNT_V2','CBGPU_MULTISCHOOL_V1','SERVICE_ROLE_KEY']as const,old=Object.fromEntries(keys.map(k=>[k,process.env[k]]));try{process.env.CBGPU_ACCOUNT_V2='1';delete process.env.CBGPU_MULTISCHOOL_V1;delete process.env.SERVICE_ROLE_KEY;assert.equal(await ownerCanExecute('11111111-1111-4111-8111-111111111111'),false);process.env.SERVICE_ROLE_KEY='fixture-not-a-real-key';for(const value of[false,null,'true',{},[]])assert.equal(await ownerCanExecute('11111111-1111-4111-8111-111111111111',async()=>new Response(JSON.stringify(value)) as any),false);assert.equal(await ownerCanExecute('11111111-1111-4111-8111-111111111111',async()=>{throw Error('offline')}),false);let calls=0;assert.equal(await ownerCanExecute('11111111-1111-4111-8111-111111111111',async(_url,options)=>{calls++;assert.equal(JSON.parse(String(options?.body)).target_school,'cbsh');return new Response('true')}),true);assert.equal(calls,1)}finally{for(const k of keys){if(old[k]===undefined)delete process.env[k];else process.env[k]=old[k]}}});
test('malformed deployment authority flags deny before any compatibility oracle fallback',async()=>{const keys=['CBGPU_ACCOUNT_V2','CBGPU_MULTISCHOOL_V1']as const,old=keys.map(key=>process.env[key]);try{for(const value of['TRUE','FALSE',' false ','0 ','tru']){process.env.CBGPU_ACCOUNT_V2='1';process.env.CBGPU_MULTISCHOOL_V1=value;let calls=0;assert.equal(await ownerCanExecute('11111111-1111-4111-8111-111111111111',async()=>{calls++;return new Response('true')}),false);assert.equal(calls,0)}}finally{keys.forEach((key,index)=>{if(old[index]===undefined)delete process.env[key];else process.env[key]=old[index]})}});
