import path from 'node:path';
import fs from'node:fs';
const UUID=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
export function ownedDeploymentPaths(root:string,id:string){if(!UUID.test(id))throw Error('Invalid deployment identity');return{directory:path.join(path.resolve(root),id),container:'cbfront-run-'+id};}
export function validatedWorkerResult(value:any,root:string,id:string){const own=ownedDeploymentPaths(root,id);if(!value||typeof value!=='object'||value.directory!==own.directory)throw Error('Worker directory does not match deployment');if(value.kind==='next'){if(value.container!==own.container||!Number.isInteger(value.port)||value.port<1||value.port>65535||value.public)throw Error('Worker runtime does not match deployment');}else if(value.kind==='static'){if(value.container||typeof value.public!=='string'||!value.public.startsWith(own.directory+path.sep)||path.resolve(value.public)!==value.public)throw Error('Worker artifact does not match deployment');}else throw Error('Unsupported worker result');return value;}
export async function cleanupOwnedDeployment(root:string,id:string,run:(command:string,args:string[])=>Promise<unknown>,remove:(directory:string)=>void){const own=ownedDeploymentPaths(root,id);await run('docker',['rm','-f',own.container]).catch(()=>{});remove(own.directory);}
export function validatedRuntimeBinding(result:any,id:string,metadata:any){if(result.kind!=='next')return;const rows=metadata;if(!Array.isArray(rows)||rows.length!==1)throw Error('Ambiguous runtime identity');const row=rows[0],ports=row.NetworkSettings?.Ports?.['3000/tcp'];if(row.Name!=='/cbfront-run-'+id||row.State?.Running!==true||!Array.isArray(ports)||ports.length!==1||ports[0].HostIp!=='127.0.0.1'||ports[0].HostPort!==String(result.port))throw Error('Worker runtime port is not owned');}
export function validatedArtifactBinding(result:any,root:string,id:string){if(result.kind!=='static')return;const directory=fs.realpathSync(ownedDeploymentPaths(root,id).directory),artifact=fs.realpathSync(result.public);if(!artifact.startsWith(directory+path.sep)||!fs.statSync(artifact).isDirectory())throw Error('Static artifact escapes deployment');}
