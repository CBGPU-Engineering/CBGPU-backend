 try{for(let i=0;i<100;i++){try{if((await fetch('http://127.0.0.1:'+port+'/health')).ok)break}catch{}assert.equal(child.exitCode,null,'Synthetic supervisor startup');await new Promise(r=>setTimeout(r,30))}let response=await call('/projects','POST',{slug:'central-fixture-'+crypto.randomBytes(5).toString('hex'),repository:'https://github.com/example/synthetic',framework:'static',auto_deploy:false,draft:true,execution_mode:'UNASSIGNED_V1'});assert.equal(response.status,201);const created=await response.json()as any,id=created.project.id;assert.equal(created.project.execution_mode,'UNASSIGNED_V1');assert.equal((await call('/projects/'+id+'/deploy','POST',{})).status,403);assert.equal((await call('/projects/'+id,'GET',undefined,crypto.randomUUID())).status,404);response=await call('/projects/'+id+'/allocate','POST',{confirmed:true,allocation_school_id:context.school_id});assert.equal(response.status,200,await response.text());response=await call('/projects/'+id);assert.equal((await response.json()as any).project.id,id);response=await call('/projects/'+id+'/deploy','POST',{});assert.equal(response.status,202);let project:any;for(let i=0;i<150;i++){project=(await(await call('/projects/'+id)).json()as any).project;const state=project.deployments?.[0];if(state?.status==='ready')break;if(state?.status==='error'){const diagnostic=new DatabaseSync(dbfile,{readOnly:true});const entry=diagnostic.prepare('SELECT logs FROM deployments WHERE id=?').get(state.id)as any;diagnostic.close();throw Error('Synthetic native build failed: '+state.error+' '+entry.logs)}await new Promise(r=>setTimeout(r,100))}assert.equal(project.deployments[0].status,'ready');const served=await new Promise<string>((resolve,reject)=>{http.get({host:'127.0.0.1',port,path:'/',headers:{Host:project.domain}},r=>{let text='';r.on('data',b=>text+=b);r.on('end',()=>resolve(text))}).on('error',reject)});assert.equal(served,'CENTRAL-STATIC-FIXTURE');assert.equal(project.id,id);assert.equal(logs.includes(stage.service),false);if(automationProof){assert.equal((await call('/projects/'+id,'PATCH',{auto_deploy:true,automation_confirmed:true})).status,200);fs.writeFileSync(path.join(tools,'revision'),'b'.repeat(40));assert.match(context.actor_session_id,/^[a-f0-9-]{36}$/);assert.match(context.owner_id,/^[a-f0-9-]{36}$/);await exec('docker',['exec','cbgpu-school-http-stage-2612869','psql','-h','/tmp','-U','cbgpu_clone_bootstrap','-d','postgres','-v','ON_ERROR_STOP=1','-c',"UPDATE auth.sessions SET not_after=clock_timestamp()-interval '1 second' WHERE id='"+context.actor_session_id+"' AND user_id='"+context.owner_id+"'"]);let autoReady=false;for(let n=0;n<1500;n++){const seen=(await(await call('/projects/'+id)).json()as any).project;if(seen.deployments?.length>=2&&seen.deployments[0].status==='ready'&&seen.deployments[0].result?.commit==='b'.repeat(40)){autoReady=true;break}if(seen.deployments?.length>=2&&seen.deployments[0].status==='error')throw Error('Delegated automatic build failed: '+seen.deployments[0].error);await new Promise(r=>setTimeout(r,100))}assert.equal(autoReady,true,'Automatic native build must work after creator session expiry without a borrowed JWT');await exec('docker',['exec','cbgpu-school-http-stage-2612869','psql','-h','/tmp','-U','cbgpu_clone_bootstrap','-d','postgres','-v','ON_ERROR_STOP=1','-c',"UPDATE auth.sessions SET not_after=NULL WHERE id='"+context.actor_session_id+"' AND user_id='"+context.owner_id+"'"]);assert.equal((await call('/projects/'+id,'PATCH',{auto_deploy:false})).status,200);const kept=(await(await call('/projects/'+id)).json()as any).project;assert.equal(kept.auto_deploy,false);assert.equal(kept.production,kept.deployments[0].id);}
const db=new DatabaseSync(dbfile,{readOnly:true});for(let n=0;n<100;n++){privateRows=db.prepare('SELECT * FROM platform_cpu_leases').all();if(privateRows.find(r=>r.purpose==='frontend_build')?.state==='RELEASED'&&privateRows.find(r=>r.purpose==='frontend_runtime')?.state==='STORAGE_RETAINED')break;await new Promise(r=>setTimeout(r,50))}assert.equal(privateRows.length,automationProof?4:2);assert.equal(privateRows.find(r=>r.purpose==='frontend_build').state,'RELEASED');assert.equal(privateRows.find(r=>r.purpose==='frontend_runtime').state,'STORAGE_RETAINED');db.close();
 }finally{if(automationProof)await exec('docker',['exec','cbgpu-school-http-stage-2612869','psql','-h','/tmp','-U','cbgpu_clone_bootstrap','-d','postgres','-c',"UPDATE auth.sessions SET not_after=NULL WHERE id='"+context.actor_session_id+"' AND user_id='"+context.owner_id+"'"]).catch(()=>{});child.kill('SIGTERM');if(child.exitCode===null)await once(child,'exit');if(fs.existsSync(dbfile)){const db=new DatabaseSync(dbfile,{readOnly:true});privateRows=db.prepare('SELECT * FROM platform_cpu_leases').all();db.close()}for(const row of privateRows){const ids=(await exec('docker',['ps','-aq','--filter','name=^cbfront-(build|run)-'+row.job_id+'$'])).stdout.trim();assert.equal(ids,'','Owned fixture containers must be absent before release')}fs.rmSync(root,{recursive:true,force:true});for(const row of privateRows.filter(r=>r.state!=='RELEASED')){const b=Buffer.from(row.private_state,'base64'),c=crypto.createDecipheriv('aes-256-gcm',key,b.subarray(0,12));c.setAuthTag(b.subarray(-16));const saved=JSON.parse(Buffer.concat([c.update(b.subarray(12,-16)),c.final()]).toString());if(!saved.lease)continue;const response=await fetch(stage.backend+'/rest/v1/rpc/cbgpu_platform_cpu_service',{method:'POST',headers:{apikey:stage.service,Authorization:'Bearer '+stage.service,'Content-Type':'application/json'},body:JSON.stringify({action:'release',payload:{lease_id:saved.lease.lease_id,lease_token:saved.lease.lease_token,instance_id:row.instance_id||'cbfront-run-'+row.job_id,stopped:true,proof:row.purpose==='frontend_runtime'?'PROJECT_DATA_REMOVED':'CONTAINER_ABSENT'}})});assert.ok(response.ok,'Synthetic lease cleanup failed')}relay.closeAllConnections();await new Promise<void>(r=>relay.close(()=>r()))}
