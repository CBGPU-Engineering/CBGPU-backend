test('actual isolated SQL leases and native static worker preserve draft ID and release real completed compute', {skip:!process.env.CBGPU_CENTRAL_CPU_STAGE_CONTEXT,timeout:240000},async()=>{
 const automationProof=process.env.CBGPU_CENTRAL_CPU_STAGE_AUTOMATION==='1';const contextPath=process.env.CBGPU_CENTRAL_CPU_STAGE_CONTEXT!;if(automationProof)assert.ok(contextPath.endsWith('context-front-auto.json'));assert.ok(contextPath.includes('central-cpu-runtime-fixture'));const context=JSON.parse(fs.readFileSync(contextPath,'utf8'));assert.equal(context.production_changes,false);const stage=JSON.parse(fs.readFileSync(path.join(path.dirname(path.dirname(contextPath)),'actors.json'),'utf8'));assert.equal(stage.backend,'http://127.0.0.1:55484');const root=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-central-node-')),key=crypto.randomBytes(32);fs.mkdirSync(path.join(root,'frontend-deployments'));fs.writeFileSync(path.join(root,'frontend-deploy-key'),key,{mode:0o600});const dbfile=path.join(root,'frontend-deployments/deploy.sqlite');new DatabaseSync(dbfile).close();const tools=path.join(root,'tools');fs.mkdirSync(tools);fs.writeFileSync(path.join(tools,'git'),'#!/usr/bin/env node\nconst fs=require("node:fs"),path=require("node:path"),a=process.argv.slice(2);if(a.includes("clone")){const d=a.at(-1);fs.mkdirSync(d,{recursive:true});fs.mkdirSync(path.join(d,".git"));fs.writeFileSync(path.join(d,"index.html"),"CENTRAL-STATIC-FIXTURE");process.exit(0)}if(a.includes("rev-parse")){console.log(fs.existsSync(path.join(__dirname,"revision"))?fs.readFileSync(path.join(__dirname,"revision"),"utf8"): "a".repeat(40));process.exit(0)}if(a.includes("ls-remote")){console.log(fs.readFileSync(path.join(__dirname,"revision"),"utf8")+"\\trefs/heads/main");process.exit(0)}process.exit(37);\n',{mode:0o700});
 // This relay NEVER returns cloned real cpu_projects or private source records.
