import test from'node:test';import assert from'node:assert/strict';import crypto from'node:crypto';import{DatabaseSync}from'node:sqlite';import{PlatformCPUAuthority}from'./platform-cpu.mts';import{platformCPUJournal}from'./platform-cpu-journal.mts';import{frontPlatformController}from'./platform-cpu-front.mts';
const a='11111111-1111-4111-8111-111111111111',s='22222222-2222-4222-8222-222222222222',p='33333333-3333-4333-8333-333333333333',j='44444444-4444-4444-8444-444444444444',key=crypto.randomBytes(32);
function seal(v:any){const iv=crypto.randomBytes(12),c=crypto.createCipheriv('aes-256-gcm',key,iv);return Buffer.concat([iv,c.update(JSON.stringify(v)),c.final(),c.getAuthTag()]).toString('base64')}function unseal(v:string){const b=Buffer.from(v,'base64'),c=crypto.createDecipheriv('aes-256-gcm',key,b.subarray(0,12));c.setAuthTag(b.subarray(-16));return JSON.parse(Buffer.concat([c.update(b.subarray(12,-16)),c.final()]).toString())}
const allocation={school_id:'school-b',project_kind:'frontend'as const,project_id:p,owner_id:a,actor_id:a,actor_session_id:s};
test('unknown acquire outcome preserves same encrypted nonce for safe retry and holds capacity on authority failure',async()=>{const old={flag:process.env.CBGPU_CENTRAL_CPU_V1,key:process.env.SERVICE_ROLE_KEY};process.env.CBGPU_CENTRAL_CPU_V1='1';process.env.SERVICE_ROLE_KEY='synthetic-private';const db=new DatabaseSync(':memory:');try{let first=true;const seen:string[]=[];const authority=new PlatformCPUAuthority(async(_u:any,o:any)=>{const b=JSON.parse(o.body);if(b.action==='acquire'){seen.push(b.payload.lease_nonce);if(first){first=false;throw Error('committed then response lost')}return Response.json({allowed:true,lease_id:j,state:'RESERVED',school_id:'school-b',purpose:'frontend_build',job_id:j})}throw Error('authority unavailable')});const journal=platformCPUJournal(db,seal,unseal,authority),budget={cpu_millis:2000,memory_bytes:2*1024**3,storage_bytes:0};await assert.rejects(journal.reserve(allocation,j,'frontend_build',budget));assert.equal(journal.active()[0].state,'PREPARED');const raw=db.prepare('SELECT private_state FROM platform_cpu_leases').get()as any;assert.equal(raw.private_state.includes(seen[0]),false);const lease=await journal.reserve(allocation,j,'frontend_build',budget);assert.equal(seen[0],seen[1]);assert.equal(lease.lease_token,seen[0]);await assert.rejects(journal.reserve(allocation,j,'frontend_build',{...budget,memory_bytes:1}));assert.equal(journal.active().length,1);await assert.rejects(authority.heartbeat(lease,'cbfront-build-'+j));assert.equal(journal.active().length,1)}finally{db.close();for(const[k,v]of[['CBGPU_CENTRAL_CPU_V1',old.flag],['SERVICE_ROLE_KEY',old.key]])if(v===undefined)delete process.env[k];else process.env[k]=v}});
test('queued central actor/session/school seal and current editor role rechecked before worker start',async()=>{const old={flag:process.env.CBGPU_CENTRAL_CPU_V1,key:process.env.SERVICE_ROLE_KEY};process.env.CBGPU_CENTRAL_CPU_V1='1';process.env.SERVICE_ROLE_KEY='synthetic';const db=new DatabaseSync(':memory:');db.exec('CREATE TABLE deployments(id TEXT,requested_by TEXT,actor_session_id TEXT,allocation_school_id TEXT,automation_delegation_id TEXT)');db.prepare('INSERT INTO deployments(id,requested_by,actor_session_id,allocation_school_id) VALUES(?,?,?,?)').run(j,a,s,'school-b');let role='owner',permission=true,calls=0;const controller=frontPlatformController(db,seal,unseal,()=>({id:p,owner:a,allocation_school_id:'school-b',_role:role}),async(_u:any,o:any)=>{calls++;assert.equal(JSON.parse(o.body).payload.actor_session_id,s);return Response.json({allowed:permission})});try{const job={id:j,project:{id:p}};assert.equal((await controller.admission(job)).decision,'ALLOW');permission=false;assert.equal((await controller.admission(job)).decision,'DENY');role='viewer';const before=calls;assert.equal((await controller.admission(job)).decision,'DENY');assert.equal(calls,before);role='owner';db.prepare('UPDATE deployments SET actor_session_id=NULL').run();assert.equal((await controller.admission(job)).decision,'DENY');assert.equal(calls,before)}finally{controller.close();db.close();for(const[k,v]of[['CBGPU_CENTRAL_CPU_V1',old.flag],['SERVICE_ROLE_KEY',old.key]])if(v===undefined)delete process.env[k];else process.env[k]=v}});
test('started owner site survives creator logout/removal and delegation revocation; owner resource loss denies continuation',async()=>{const old={flag:process.env.CBGPU_CENTRAL_CPU_V1,key:process.env.SERVICE_ROLE_KEY};process.env.CBGPU_CENTRAL_CPU_V1='1';process.env.SERVICE_ROLE_KEY='synthetic';const db=new DatabaseSync(':memory:');db.exec('CREATE TABLE deployments(id TEXT,requested_by TEXT,actor_session_id TEXT,allocation_school_id TEXT,automation_delegation_id TEXT)');const collaborator='55555555-5555-4555-8555-555555555555';let removed=false,ownerAllowed=true,delegation=true;const controller=frontPlatformController(db,seal,unseal,(id,actor)=>({id,owner:a,allocation_school_id:'school-b',production:j,_role:actor===a?'owner':removed?'viewer':'editor'}),async(_u:any,o:any)=>{const body=JSON.parse(o.body);if(body.action==='acquire')return Response.json({allowed:true,lease_id:j,state:'RESERVED',school_id:'school-b',purpose:'frontend_runtime',job_id:j});if(body.action==='start')return Response.json({allowed:true});if(body.action==='heartbeat')return Response.json({allowed:ownerAllowed,stop_required:!ownerAllowed,state:'RUNNING'});if(body.action==='delegate_create')return Response.json({delegation_id:j,revision:1,enabled:true,allowed:true,school_id:'school-b',project_id:p});if(body.action==='delegate_inspect')return Response.json({delegation_id:j,revision:1,enabled:delegation,allowed:delegation&&ownerAllowed,school_id:'school-b',project_id:p});throw Error('Unexpected action')});controller.close();try{const allocation={school_id:'school-b',project_kind:'frontend' as const,project_id:p,owner_id:a,actor_id:collaborator,actor_session_id:s};const lease=await controller.journal.reserve(allocation,j,'frontend_runtime',{cpu_millis:1000,memory_bytes:768*1024**2,storage_bytes:5*1024**3});await controller.journal.start(lease,'cbfront-run-'+j,s);const project={id:p,owner:a,allocation_school_id:'school-b',production:j};assert.equal(await controller.serving(project),'ALLOW');removed=true;assert.equal(await controller.serving(project),'ALLOW','creator collaborator removal/logout is not owner resource revocation');await controller.automation.configure(project,a,s,true);assert.ok(await controller.automation.context(project));delegation=false;assert.equal(await controller.automation.context(project),null);assert.equal(await controller.serving(project),'ALLOW','delegation revocation blocks new jobs, not owned persistent runtime');ownerAllowed=false;assert.equal(await controller.serving(project),'DENY')}finally{controller.close();db.close();for(const[k,v]of[['CBGPU_CENTRAL_CPU_V1',old.flag],['SERVICE_ROLE_KEY',old.key]])if(v===undefined)delete process.env[k];else process.env[k]=v}});
