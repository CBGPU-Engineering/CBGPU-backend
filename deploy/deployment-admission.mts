export type Admission='ALLOW'|'DENY'|'UNAVAILABLE';
/** The queued actor is persisted by the trusted API, never recovered from customer configuration. */
export async function queuedDeploymentAdmission(job:{project_id:string;requested_by?:string|null},deps:{enforced:boolean;loadProject:(id:string,actor:string)=>Promise<any>|any;decision:(user:string)=>Promise<Admission>;legacyOwner?:string}){const actor=job.requested_by||(!deps.enforced?deps.legacyOwner:null);if(!actor)return{decision:'DENY' as Admission};let project:any;try{project=await deps.loadProject(job.project_id,actor)}catch(error){return{decision:([403,404].includes((error as {status?:number}).status||0)?'DENY':'UNAVAILABLE') as Admission}}if(!project||project.deleted||project._role==='viewer')return{decision:'DENY' as Admission};for(const user of new Set([actor,project.owner])){const decision=await deps.decision(user);if(decision!=='ALLOW')return{decision}}return{decision:'ALLOW' as Admission,project}}
/** Unknown authority withdraws access without stopping workloads. Denial cannot silently resume old work. */
export async function gateComposeAccess(input:{decision:Admission;previousDenied:boolean;newRequest:boolean;stopOnDenial:boolean},effects:{withdraw:()=>Promise<void>|void;mark:(state:Admission)=>Promise<void>|void;suspend:()=>Promise<void>|void;allow:()=>Promise<void>|void}){if(input.decision!=='ALLOW'){await effects.withdraw();await effects.mark(input.previousDenied?'DENY':input.decision);if(input.decision==='DENY'&&input.stopOnDenial)await effects.suspend();return false}if(input.previousDenied&&!input.newRequest){await effects.withdraw();return false}await effects.mark('ALLOW');await effects.allow();return true}
