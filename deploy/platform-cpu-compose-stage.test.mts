test('actual Node Compose launch binds SQL quota, Docker generation, and retained storage', {skip:!process.env.CBGPU_CENTRAL_CPU_COMPOSE_STAGE_CONTEXT,timeout:120000},async()=>{
 const contextPath=process.env.CBGPU_CENTRAL_CPU_COMPOSE_STAGE_CONTEXT!;assert.ok(contextPath.includes('central-cpu-runtime-fixture'));const context=JSON.parse(fs.readFileSync(contextPath,'utf8'));assert.equal(context.production_changes,false);const stage=JSON.parse(fs.readFileSync(path.join(path.dirname(path.dirname(contextPath)),'actors.json'),'utf8'));assert.equal(stage.backend,'http://127.0.0.1:55484');
 const root=fs.mkdtempSync(path.join(os.tmpdir(),'central-compose-node-')),home=path.join(root,'home'),key=crypto.randomBytes(32),id=crypto.randomUUID(),namespace='cbgpu-compose-'+id;const privateRoot=path.join(root,'private'),data=path.join(privateRoot,'frontend-deployments');fs.mkdirSync(data,{recursive:true});fs.writeFileSync(path.join(privateRoot,'frontend-deploy-key'),key,{mode:0o600});new DatabaseSync(path.join(data,'deploy.sqlite')).close();
