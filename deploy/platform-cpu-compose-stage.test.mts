import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import os from'node:os';import path from'node:path';import crypto from'node:crypto';import http from'node:http';import{spawn,execFile}from'node:child_process';import{once}from'node:events';import{promisify}from'node:util';import{DatabaseSync}from'node:sqlite';import{fileURLToPath}from'node:url';
