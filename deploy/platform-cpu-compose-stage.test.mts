  const stopped=await fetch('http://127.0.0.1:'+port+'/compose/'+id,{method:'DELETE',headers:{'x-cbgpu-deploy-key':key.toString('hex'),'x-cbgpu-owner':context.owner_id,'x-cbgpu-resource-owner':context.owner_id}});assert.equal(stopped.status,200);const afterStop=new DatabaseSync(path.join(data,'deploy.sqlite'),{readOnly:true});const retained=afterStop.prepare("SELECT state FROM platform_cpu_leases WHERE project_kind='compose' AND project_id=? AND purpose='compose_runtime'").get(id)as any;afterStop.close();assert.equal(retained.state,'STORAGE_RETAINED');
 }finally{
  if(child){child.kill('SIGTERM');if(child.exitCode===null)await once(child,'exit')}if(fs.existsSync(path.join(data,'deploy.sqlite'))){const db=new DatabaseSync(path.join(data,'deploy.sqlite'),{readOnly:true});if(db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='platform_cpu_leases'").get())leases=db.prepare("SELECT * FROM platform_cpu_leases WHERE project_kind='compose' AND project_id=?").all(id);db.close()}
  for(const kind of ['container','volume','network']){const args=kind==='container'?['ps','-aq','--filter','label=com.docker.compose.project='+namespace]:[kind,'ls','-q','--filter','label=com.docker.compose.project='+namespace];const ids=(await exec('docker',args)).stdout.trim().split(/\s+/).filter(Boolean);if(ids.length)await exec('docker',[kind==='container'?'rm':kind,...(kind==='container'?['-f']:['rm']),...ids])}
  fs.rmSync(root,{recursive:true,force:true});for(const row of leases.filter(r=>r.state!=='RELEASED')){const b=Buffer.from(row.private_state,'base64'),c=crypto.createDecipheriv('aes-256-gcm',key,b.subarray(0,12));c.setAuthTag(b.subarray(-16));const saved=JSON.parse(Buffer.concat([c.update(b.subarray(12,-16)),c.final()]).toString());if(saved.lease)await rpc('release',{lease_id:saved.lease.lease_id,lease_token:saved.lease.lease_token,instance_id:row.instance_id,stopped:true,proof:row.purpose==='compose_runtime'?'PROJECT_DATA_REMOVED':'PROCESS_EXITED'})}await api('cpu_projects?id=eq.'+id,'DELETE');if(relay){relay.closeAllConnections();await new Promise<void>(r=>relay.close(()=>r()))}
