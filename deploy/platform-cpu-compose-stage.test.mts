 const tools=path.join(root,'tools');fs.mkdirSync(tools);fs.writeFileSync(path.join(tools,'git'),'#!/usr/bin/env node\nconst fs=require("node:fs"),p=require("node:path"),a=process.argv.slice(2);if(!a.includes("clone"))process.exit(37);const d=a.at(-1);fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,"compose.yml"),JSON.stringify({services:{web:{image:"nginx:alpine"}}}));\n',{mode:0o700});
 const api=async(url:string,method='GET',body?:any)=>{const r=await fetch(stage.backend+'/rest/v1/'+url,{method,headers:{apikey:stage.service,Authorization:'Bearer '+stage.service,'Content-Type':'application/json',Prefer:'return=representation'},body:body===undefined?undefined:JSON.stringify(body),redirect:'error'});const text=await r.text();if(!r.ok)fs.writeFileSync('/tmp/cbgpu-central-compose-authority-error.json',text,{mode:0o600});assert.ok(r.ok,'Isolated authority request failed '+r.status);return text?JSON.parse(text):null};
