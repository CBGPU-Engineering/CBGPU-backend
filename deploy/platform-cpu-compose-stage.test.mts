  let ready:any;for(let n=0;n<600;n++){assert.equal(child.exitCode,null,'Fixture supervisor exited');try{const r=await fetch('http://127.0.0.1:'+port+'/compose/'+id,{headers:{'x-cbgpu-deploy-key':key.toString('hex'),'x-cbgpu-owner':context.owner_id,'x-cbgpu-resource-owner':context.owner_id}});if(r.ok){const value=await r.json()as any;if(value.status==='ready'){ready=value;break}if(value.status==='error')throw Error('Managed Compose failed: '+value.error+' '+value.logs)}}catch(e){if((e as Error).message.startsWith('Managed Compose failed'))throw e}await new Promise(r=>setTimeout(r,100))}assert.ok(ready,'Actual supervisor did not publish managed Compose');assert.equal(logs.includes(stage.service),false);
  const db=new DatabaseSync(path.join(data,'deploy.sqlite'),{readOnly:true});for(let n=0;n<100;n++){leases=db.prepare("SELECT * FROM platform_cpu_leases WHERE project_kind='compose' AND project_id=?").all(id);if(leases.find(r=>r.purpose==='compose_build')?.state==='RELEASED')break;await new Promise(r=>setTimeout(r,50))}const state=db.prepare('SELECT result FROM compose_states WHERE project_id=?').get(id)as any;db.close();assert.equal(leases.length,2);assert.equal(leases.find(r=>r.purpose==='compose_build').state,'RELEASED');assert.equal(leases.find(r=>r.purpose==='compose_runtime').state,'RUNNING');const result=JSON.parse(state.result);assert.equal(result.platform_generation,leases[0].job_id);
  const ids=(await exec('docker',['ps','-aq','--filter','label=com.docker.compose.project='+namespace])).stdout.trim().split(/\s+/).filter(Boolean);assert.ok(ids.length);const rows=JSON.parse((await exec('docker',['inspect',...ids])).stdout);assert.ok(rows.every((r:any)=>r.Config.Labels['cbgpu.platform.project']===id&&r.Config.Labels['cbgpu.platform.generation']===result.platform_generation));
  const served=await new Promise<string>((resolve,reject)=>{http.get({hostname:'127.0.0.1',port,path:'/',headers:{host:'server-'+id.slice(0,8)+'.server.cbgpu.com'}},r=>{let s='';r.on('data',b=>s+=b);r.on('end',()=>resolve(s))}).on('error',reject)});assert.match(served,/Welcome to nginx/);
