import{platformAutomation}from'./platform-cpu-automation.mts';
import{PlatformCPUAuthority,platformCPUEnabled,type PlatformAllocation}from'./platform-cpu.mts';
import{platformCPUJournal}from'./platform-cpu-journal.mts';
import fs from'node:fs';import path from'node:path';
import{execFile}from'node:child_process';import{promisify}from'node:util';const docker=promisify(execFile);
async function absent(name:string){if(!/^cbfront-(?:build|run)-[a-f0-9-]{36}$/.test(name))throw Error('Invalid owned container');const out=await docker('docker',['ps','-aq','--filter','name=^'+name+'$'],{timeout:5000,maxBuffer:1024});return out.stdout.trim()===''}
/** Actual frontend-controller adapter. All credentials remain in private AEAD journal. */
export function frontPlatformController(db:any,seal:(v:unknown)=>string,unseal:(s:string)=>any,findProject:(id:string,actor:string)=>any,transport:typeof fetch=fetch){
 const authority=new PlatformCPUAuthority(transport),automation=platformAutomation(db,seal,unseal,authority),journal=platformCPUJournal(db,seal,unseal,authority);
 function context(p:any,actor:string,session:string):PlatformAllocation{return{school_id:p.allocation_school_id,project_kind:'frontend',project_id:p.id,owner_id:p.owner,actor_id:actor,actor_session_id:session}}
 async function admission(job:any){const saved=db.prepare('SELECT requested_by,actor_session_id,allocation_school_id,automation_delegation_id FROM deployments WHERE id=?').get(job.id);if(!saved?.requested_by||!saved?.actor_session_id&&!saved?.automation_delegation_id||!platformCPUEnabled())return{decision:'DENY' as const};let p:any;try{p=findProject(job.project.id,saved.requested_by)}catch{return{decision:'DENY' as const}}if(p._role==='viewer'||!p.allocation_school_id||p.allocation_school_id!==saved.allocation_school_id)return{decision:'DENY' as const};try{if(saved.automation_delegation_id){const a=await automation.context(p);if(!a||a.delegation_id!==saved.automation_delegation_id||saved.requested_by!==p.owner)return{decision:'DENY' as const};return{decision:'ALLOW' as const,project:p,allocation:a}}await authority.seal(context(p,saved.requested_by,saved.actor_session_id));return{decision:'ALLOW' as const,project:p,allocation:context(p,saved.requested_by,saved.actor_session_id)}}catch(e){return{decision:(e as any).status===403?'DENY' as const:'UNAVAILABLE' as const}}}
 async function completion(job:any){try{const p=findProject(job.project.id,job.project.owner);if(!p.allocation_school_id||p.owner!==job.project.owner)return{decision:'DENY' as const};const row=journal.active().find((r:any)=>r.project_kind==='frontend'&&r.project_id===p.id&&r.job_id===job.id&&r.purpose==='frontend_runtime');if(!row||row.private_state?.allocation?.owner_id!==p.owner||row.school_id!==p.allocation_school_id)return{decision:'DENY' as const};return{decision:(await journal.heartbeat(row)).allowed===true?'ALLOW' as const:'DENY' as const}}catch{return{decision:'UNAVAILABLE' as const}}}
 async function prepare(job:any,allocation:PlatformAllocation){const build=await journal.reserve(allocation,job.id,'frontend_build',{cpu_millis:2000,memory_bytes:2*1024**3,storage_bytes:0});const runtime=await journal.reserve(allocation,job.id,'frontend_runtime',{cpu_millis:1000,memory_bytes:768*1024**2,storage_bytes:5*1024**3});await journal.start(build,'cbfront-build-'+job.id,allocation.actor_session_id);await journal.start(runtime,'cbfront-run-'+job.id,allocation.actor_session_id);return{build,runtime}}
 async function serving(p:any):Promise<'ALLOW'|'DENY'|'UNAVAILABLE'>{if(!p.allocation_school_id)return'DENY';if(!platformCPUEnabled())return'DENY';const rows=journal.active().filter((r:any)=>r.project_kind==='frontend'&&r.project_id===p.id&&r.job_id===p.production&&r.purpose==='frontend_runtime');if(rows.length!==1)return'DENY';const row=rows[0];if(row.state==='DENIED_LOCAL'||row.blocked)return'DENY';try{const current=findProject(p.id,p.owner);if(current.owner!==row.private_state.allocation.owner_id||current.allocation_school_id!==row.school_id)return'DENY';const response=await journal.heartbeat(row);return response.allowed===true?'ALLOW':'DENY'}catch{return'UNAVAILABLE'}}
 async function cancelNeverLaunched(jobId:string,dataRoot:string){if(fs.existsSync(path.join(dataRoot,jobId)))return;for(const row of journal.active().filter((r:any)=>r.project_kind==='frontend'&&r.job_id===jobId&&r.private_state?.lease)){const name=(row.purpose==='frontend_build'?'cbfront-build-':'cbfront-run-')+jobId;if(!await absent(name))continue;const inspect=await authority.call('inspect',{lease_id:row.private_state.lease.lease_id,lease_token:row.private_state.lease.lease_token});if(inspect.instance_id&&inspect.instance_id!==name)throw Error('CPU runtime binding changed');await authority.call('release',{lease_id:row.private_state.lease.lease_id,lease_token:row.private_state.lease.lease_token,instance_id:name,stopped:true,proof:row.purpose==='frontend_runtime'?'PROJECT_DATA_REMOVED':'CONTAINER_ABSENT'});db.prepare("UPDATE platform_cpu_leases SET state='RELEASED' WHERE project_kind=? AND project_id=? AND job_id=? AND purpose=?").run(row.project_kind,row.project_id,row.job_id,row.purpose)}}
 async function completed(jobId:string,result?:any){for(const row of journal.active().filter((r:any)=>r.project_kind==='frontend'&&r.job_id===jobId&&r.purpose==='frontend_build')){const name='cbfront-build-'+jobId;if(await absent(name))await journal.releaseCompleted(row,{runtime_ref:name,runtime_absent:true,build_process_exited:true})}if(result?.kind!=='next'){for(const row of journal.active().filter((r:any)=>r.project_kind==='frontend'&&r.job_id===jobId&&r.purpose==='frontend_runtime')){const name='cbfront-run-'+jobId;if(await absent(name))await journal.retireStopped(row,name)}}}
 let checking=false;const timer=setInterval(async()=>{if(checking)return;checking=true;try{for(const row of journal.active().filter((r:any)=>r.project_kind==='frontend'&&r.purpose==='frontend_runtime'&&r.private_state?.lease)){if(row.blocked){const name='cbfront-run-'+row.job_id;if(await absent(name))await journal.retireStopped(row,name).catch(()=>{});continue}let allowed=false;try{const p=findProject(row.project_id,row.private_state.allocation.owner_id);allowed=p.owner===row.private_state.allocation.owner_id&&p.allocation_school_id===row.school_id;if(allowed)allowed=(await journal.heartbeat(row)).allowed===true}catch{continue}if(!allowed){db.prepare('UPDATE platform_cpu_leases SET state=?,blocked=1 WHERE project_kind=? AND project_id=? AND job_id=? AND purpose=?').run('DENIED_LOCAL',row.project_kind,row.project_id,row.job_id,row.purpose);const name='cbfront-run-'+row.job_id;if(!await absent(name))await docker('docker',['stop','--time','20',name],{timeout:30000,maxBuffer:1024}).catch(()=>{});await docker('docker',['rm',name],{timeout:5000,maxBuffer:1024}).catch(()=>{});if(await absent(name))await journal.retireStopped(row,name).catch(()=>{});/* Retained files keep persistent reservation counted. */}}}finally{checking=false}},10000);timer.unref();
 return{authority,journal,automation,context,admission,completion,prepare,serving,completed,cancelNeverLaunched,close:()=>clearInterval(timer)};
}
