import crypto from'node:crypto';import{PlatformCPUAuthority,type PlatformAllocation}from'./platform-cpu.mts';
/** Only an actual owner action creates/revokes delegation. Polling never refreshes/mints user sessions. */
export function platformAutomation(db:any,seal:(v:unknown)=>string,unseal:(v:string)=>any,authority=new PlatformCPUAuthority()){
 db.exec(`CREATE TABLE IF NOT EXISTS platform_cpu_automation(project_id TEXT PRIMARY KEY,school_id TEXT NOT NULL,owner_id TEXT NOT NULL,private_nonce TEXT NOT NULL,delegation_id TEXT,revision INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL,updated_at TEXT NOT NULL)`);
 async function configure(p:any,actor:string,session:string,enabled:boolean){if(actor!==p.owner||!p.allocation_school_id)throw Object.assign(Error('Only owner can configure central CPU automation'),{status:403});let row=db.prepare('SELECT * FROM platform_cpu_automation WHERE project_id=?').get(p.id);if(!enabled){if(row?.delegation_id){const out=await authority.call('delegate_revoke',{delegation_id:row.delegation_id,owner_id:p.owner,actor_id:actor,actor_session_id:session,expected_revision:row.revision});db.prepare("UPDATE platform_cpu_automation SET state='REVOKED',revision=?,updated_at=? WHERE project_id=?").run(out.revision,new Date().toISOString(),p.id)}return}
 if(!row){db.prepare("INSERT INTO platform_cpu_automation(project_id,school_id,owner_id,private_nonce,state,updated_at)VALUES(?,?,?,?,?,?)").run(p.id,p.allocation_school_id,p.owner,seal({nonce:crypto.randomBytes(32).toString('hex')}),'PREPARED',new Date().toISOString());row=db.prepare('SELECT * FROM platform_cpu_automation WHERE project_id=?').get(p.id)}if(row.owner_id!==p.owner||row.school_id!==p.allocation_school_id)throw Error('Automation allocation mismatch');const nonce=unseal(row.private_nonce).nonce;const out=await authority.call('delegate_create',{school_id:p.allocation_school_id,project_kind:'frontend',project_id:p.id,owner_id:p.owner,actor_id:actor,actor_session_id:session,delegation_nonce:nonce,expected_revision:row.revision});if(typeof out.delegation_id!=='string'||!Number.isSafeInteger(out.revision)||out.school_id!==p.allocation_school_id||out.project_id!==p.id)throw Error('Invalid automation delegation');db.prepare("UPDATE platform_cpu_automation SET delegation_id=?,revision=?,state='ENABLED',updated_at=? WHERE project_id=?").run(out.delegation_id,out.revision,new Date().toISOString(),p.id)}
 async function context(p:any):Promise<PlatformAllocation|null>{const row=db.prepare('SELECT * FROM platform_cpu_automation WHERE project_id=?').get(p.id);if(!row||row.state!=='ENABLED'||row.owner_id!==p.owner||row.school_id!==p.allocation_school_id)return null;const token=unseal(row.private_nonce).nonce,out=await authority.call('delegate_inspect',{delegation_id:row.delegation_id,delegation_token:token});if(out.enabled!==true||out.allowed!==true||out.capacity_available===false||out.project_id!==p.id||out.school_id!==p.allocation_school_id)return null;return{school_id:p.allocation_school_id,project_kind:'frontend',project_id:p.id,owner_id:p.owner,actor_id:p.owner,delegation_id:row.delegation_id,delegation_token:token}}
 return{configure,context};
}
