import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import os from'node:os';import path from'node:path';import http from'node:http';import{once}from'node:events';import{spawn}from'node:child_process';import{DatabaseSync}from'node:sqlite';import{fileURLToPath}from'node:url';
const owner='11111111-1111-4111-8111-111111111111',foreign='22222222-2222-4222-8222-222222222222';
test('actual Node supervisor retains scoped personal drafts/history while compute stays denied and foreign ownership remains private',async()=>{
 const root=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-deploy-supervisor-'));fs.mkdirSync(path.join(root,'frontend-deployments'));const key=Buffer.alloc(32,19);fs.writeFileSync(path.join(root,'frontend-deploy-key'),key,{mode:0o600});const database=path.join(root,'frontend-deployments/deploy.sqlite'),seed=new DatabaseSync(database);seed.exec('CREATE TABLE fixture_keep(value TEXT);INSERT INTO fixture_keep VALUES(\'retained\')');seed.close();let computeChecks=0;const backend=http.createServer(async(req,res)=>{res.setHeader('content-type','application/json');if(req.url==='/rest/v1/rpc/cbgpu_service_can_use_resource'){assert.equal(req.headers.authorization,'Bearer fixture-private-runtime');let raw='';for await(const chunk of req)raw+=chunk;const body=JSON.parse(raw);assert.equal(body.resource,'school_compute');assert.equal(body.target_school,'cbsh');computeChecks++;return res.end('false')}if(req.url?.startsWith('/rest/v1/cpu_projects'))return res.end('[]');res.statusCode=404;res.end('{}')});backend.listen(0,'127.0.0.1');await once(backend,'listening');const address=backend.address()as{port:number};const reserve=http.createServer();reserve.listen(0,'127.0.0.1');await once(reserve,'listening');const port=(reserve.address()as{port:number}).port;await new Promise<void>(resolve=>reserve.close(()=>resolve()));const entry=fileURLToPath(new URL('./server.mts',import.meta.url));const child=spawn(process.execPath,['--no-warnings',entry],{env:{...process.env,CBGPU_DEPLOY_PRIVATE:root,CBGPU_DEPLOY_LISTEN_PORT:String(port),CBGPU_DEPLOY_BACKEND_URL:'http://127.0.0.1:'+address.port,CBGPU_MULTISCHOOL_V1:'1',CBGPU_ACCOUNT_V2:'0',SERVICE_ROLE_KEY:'fixture-private-runtime'},stdio:['ignore','pipe','pipe']});let logs='';child.stdout.on('data',x=>logs+=x);child.stderr.on('data',x=>logs+=x);
 const call=(url:string,actor=owner,method='GET',body?:unknown)=>fetch('http://127.0.0.1:'+port+url,{method,headers:{'x-cbgpu-deploy-key':key.toString('hex'),'x-cbgpu-owner':actor,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});
 try{for(let n=0;n<100;n++){try{if((await fetch('http://127.0.0.1:'+port+'/health')).ok)break}catch{}if(child.exitCode!==null)throw Error('Fixture supervisor failed startup');await new Promise(r=>setTimeout(r,30))}assert.equal((await call('/projects')).status,200);assert.equal(computeChecks,0,'ownership reads cannot depend on school compute');const config={slug:'fixture-private-draft',repository:'https://github.com/example/synthetic',auto_deploy:false,framework:'static',env:{PRIVATE_VALUE:'fixture-private-value'}};let r=await call('/projects',owner,'POST',config);assert.equal(r.status,403);r=await call('/projects',owner,'POST',{...config,draft:true});assert.equal(r.status,201);const created=await r.json()as any,id=created.project.id;assert.equal(created.deployment_id,null);assert.deepEqual(created.project.environment_keys,['PRIVATE_VALUE']);assert.equal(JSON.stringify(created).includes('fixture-private-value'),false);r=await call('/projects');const own=await r.json()as any;assert.equal(own.projects.length,1);assert.equal(own.projects[0].id,id);r=await call('/projects',foreign);assert.equal((await r.json()as any).projects.length,0);assert.equal((await call('/projects/'+id,foreign)).status,404);assert.equal((await call('/projects/'+id,owner,'PATCH',{branch:'feature/retained',build_command:'echo synthetic'})).status,200);assert.equal((await call('/projects/'+id+'/deploy',owner,'POST',{})).status,403);r=await call('/projects/'+id);assert.equal((await r.json()as any).project.branch,'feature/retained');const db=new DatabaseSync(database,{readOnly:true});assert.equal((db.prepare('SELECT COUNT(*) AS n FROM deployments').get()as any).n,0);assert.equal((db.prepare('SELECT value FROM fixture_keep').get()as any).value,'retained');assert.equal(db.prepare('SELECT secrets FROM projects').get()!.secrets.toString().includes('fixture-private-value'),false);db.close();assert.deepEqual(fs.readFileSync(path.join(root,'frontend-deploy-key')),key);assert.ok(computeChecks>=2);assert.equal(logs.includes('fixture-private-value'),false)}finally{child.kill('SIGTERM');if(child.exitCode===null)await once(child,'exit');backend.closeAllConnections();await new Promise<void>(resolve=>backend.close(()=>resolve()));fs.rmSync(root,{recursive:true,force:true})}
});
