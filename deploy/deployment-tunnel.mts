import http from'node:http';
export type TunnelTarget={port:number;_owner?:string;_project?:string;_kind?:string};
type Options={headers:(headers:Record<string,any>)=>Record<string,any>;responseHeaders:(headers:Record<string,any>)=>Record<string,any>;intervalMs:number};
function sameTarget(a:TunnelTarget,b:TunnelTarget|null){return!!b&&a.port===b.port&&a._owner===b._owner&&a._project===b._project&&a._kind===b._kind}
function watchTarget(target:TunnelTarget,resolve:()=>Promise<TunnelTarget|null>,close:()=>void,ms:number){let checking=false,disposed=false;if(!ms)return()=>{};const timer=setInterval(()=>{if(checking||disposed)return;checking=true;void resolve().then(current=>{if(!disposed&&!sameTarget(target,current))close()}).catch(()=>{if(!disposed)close()}).finally(()=>{checking=false})},ms);timer.unref();return()=>{disposed=true;clearInterval(timer)}}
export function proxyDeploymentHTTP(req:any,res:any,target:TunnelTarget,resolve:()=>Promise<TunnelTarget|null>,options:Options){let stop=()=>{};const upstream=http.request({host:'127.0.0.1',port:target.port,path:req.url,method:req.method,headers:options.headers(req.headers)},response=>{res.writeHead(response.statusCode||502,options.responseHeaders(response.headers));response.pipe(res)});const close=()=>{stop();upstream.destroy();res.destroy()};stop=watchTarget(target,resolve,close,options.intervalMs);upstream.on('error',()=>{stop();if(!res.headersSent){res.writeHead(502);res.end('Deployment unavailable')}else res.destroy()});req.on('aborted',close);res.on('close',()=>{stop();upstream.destroy()});req.pipe(upstream)}
export async function upgradeDeployment(req:any,socket:any,head:Buffer,resolve:()=>Promise<TunnelTarget|null>,options:Options){let target:TunnelTarget|null;try{target=await resolve()}catch{target=null}if(!target?.port){socket.end('HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n');return}let stop=()=>{},remote:any;const upstream=http.request({host:'127.0.0.1',port:target.port,path:req.url,headers:options.headers(req.headers)});const close=()=>{stop();upstream.destroy();remote?.destroy();socket.destroy()};stop=watchTarget(target,resolve,close,options.intervalMs);socket.on('error',close);socket.on('close',close);upstream.on('upgrade',(response,next,remoteHead)=>{remote=next;socket.write('HTTP/1.1 101 Switching Protocols\r\n'+Object.entries(options.responseHeaders(response.headers)).flatMap(([key,value])=>(Array.isArray(value)?value:[value]).map(item=>key+': '+item+'\r\n')).join('')+'\r\n');if(head.length)remote.write(head);if(remoteHead.length)socket.write(remoteHead);socket.pipe(remote).pipe(socket);remote.on('error',close);remote.on('close',close)});upstream.on('response',response=>{stop();socket.end('HTTP/1.1 '+response.statusCode+' Rejected\r\nConnection: close\r\n\r\n');response.resume()});upstream.on('error',close);upstream.end()}
