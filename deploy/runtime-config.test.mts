import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import os from'node:os';import path from'node:path';import{deploymentBackendOrigin,deploymentListenPort,deploymentStatePaths,composeManagedFile}from'./runtime-config.mts';
test('private metadata/listener defaults are unchanged and explicit fixture endpoints stay loopback',()=>{assert.equal(deploymentBackendOrigin({}),'http://127.0.0.1:54321');assert.equal(deploymentListenPort({}),3510);assert.equal(deploymentBackendOrigin({CBGPU_DEPLOY_BACKEND_URL:'http://127.0.0.1:55484'}),'http://127.0.0.1:55484');for(const value of['',' https://localhost','http://localhost/path','http://user:password@127.0.0.1','http://public.example','http://127.0.0.1?x=1','ftp://localhost'])assert.throws(()=>deploymentBackendOrigin({CBGPU_DEPLOY_BACKEND_URL:value}),/Invalid private/);for(const value of['0','80','65536','3510x',' 3510',''])assert.throws(()=>deploymentListenPort({CBGPU_DEPLOY_LISTEN_PORT:value}),/Invalid private/)});
test('explicit handoff refuses missing state and reuses exact existing key/database without generating data',()=>{const root=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-deploy-paths-'));try{assert.throws(()=>deploymentStatePaths('/fixture/deploy',{CBGPU_DEPLOY_PRIVATE:root}),/refusing empty handoff/);assert.deepEqual(fs.readdirSync(root),[]);fs.mkdirSync(path.join(root,'frontend-deployments'));fs.writeFileSync(path.join(root,'frontend-deploy-key'),Buffer.alloc(32,7),{mode:0o600});fs.writeFileSync(path.join(root,'frontend-deployments/deploy.sqlite'),'synthetic-existing-database');const before=fs.readFileSync(path.join(root,'frontend-deploy-key')),paths=deploymentStatePaths('/different/release/deploy',{CBGPU_DEPLOY_PRIVATE:root});assert.equal(paths.privateRoot,fs.realpathSync(root));assert.equal(paths.database,path.join(root,'frontend-deployments/deploy.sqlite'));assert.deepEqual(fs.readFileSync(paths.key),before);assert.equal(fs.readFileSync(paths.database,'utf8'),'synthetic-existing-database');fs.unlinkSync(paths.key);fs.symlinkSync(paths.database,paths.key);assert.throws(()=>deploymentStatePaths('/fixture',{CBGPU_DEPLOY_PRIVATE:root}),/refusing empty handoff/)}finally{fs.rmSync(root,{recursive:true,force:true})}});

test('legacy absolute release aliases remain valid only inside the canonical existing Compose project',()=>{const root=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-compose-paths-')),id='11111111-1111-4111-8111-111111111111';try{const base=path.join(root,'store'),project=path.join(base,id),outside=path.join(root,'outside');fs.mkdirSync(path.join(project,'release'),{recursive:true});fs.mkdirSync(outside);const file=path.join(project,'release/compose-managed.json');fs.writeFileSync(file,'{}');const alias=path.join(root,'old-release-private');fs.symlinkSync(base,alias);assert.equal(composeManagedFile(base,id,path.join(alias,id,'release/compose-managed.json')),file);fs.writeFileSync(path.join(outside,'foreign.json'),'{}');fs.symlinkSync(path.join(outside,'foreign.json'),path.join(project,'escape.json'));assert.throws(()=>composeManagedFile(base,id,path.join(project,'escape.json')),/Invalid Compose/);assert.throws(()=>composeManagedFile(base,id,path.join(outside,'foreign.json')),/Invalid Compose/);assert.throws(()=>composeManagedFile(base,'../../outside',file),/Invalid Compose/)}finally{fs.rmSync(root,{recursive:true,force:true})}});
