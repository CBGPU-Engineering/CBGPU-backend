import test from'node:test';import assert from'node:assert/strict';import http from'node:http';import {once}from'node:events';import {requestCookieBoundary,responseCookieBoundary,safeSetCookie}from'../cookie-boundary.mts';
test('parent and reserved cookies cannot be planted by a tenant',()=>{for(const value of ['sb-cbgpu-auth-token.0=stolen; Secure','CBGPU-session=x','__Host-cbgpu-latex=x; Secure; Path=/','__Secure-cbgpu-workspace=x','login=x; Domain=.cbgpu.com','login=x; Domain=server.cbgpu.com','login=x; Domain=other.server.cbgpu.com','login=x; Domain=tenant.server.cbgpu.com; Domain=cbgpu.com','login=x; Domain="cbgpu.com"','login=x; Domain=cbgpu.com.'])assert.equal(safeSetCookie(value,'tenant.server.cbgpu.com'),false,value)});
test('own tenant cookies, expiry commas and owned external parents survive',()=>{for(const value of ['app_session=own; HttpOnly; Secure; Path=/','app_session=own; Domain=tenant.server.cbgpu.com','app_session=own; Expires=Wed, 21 Oct 2030 07:28:00 GMT'])assert.equal(safeSetCookie(value,'tenant.server.cbgpu.com'),true,value);assert.equal(safeSetCookie('session=own; Domain=example.org','app.example.org'),true);assert.equal(safeSetCookie('session=own; Domain=cbgpu.com','app.example.org'),false);assert.equal(safeSetCookie('session=own; Domain=other.example.org','app.example.org'),false)});
test('request removes protected names while retaining tenant credentials',()=>{const input={cookie:'sb-cbgpu-auth-token.0=private; __Host-cbgpu-latex=private; cbgpu-other=private; own=ok',authorization:'Bearer tenant-own-api','x-cbgpu-owner':'spoof'};const headers=requestCookieBoundary(input);assert.equal(headers.cookie,'own=ok');assert.equal(headers.authorization,'Bearer tenant-own-api');assert.equal(headers['x-cbgpu-owner'],undefined);assert.match(input.cookie,/private/);assert.equal(responseCookieBoundary({'set-cookie':['sb-cbgpu-auth-token.0=poison','own=ok']},'tenant.server.cbgpu.com')['set-cookie']?.[0],'own=ok')});
test('actual HTTP and WS responses enforce the same boundary',async()=>{let observed='';const upstream=http.createServer((req,res)=>{observed=req.headers.cookie||'';assert.equal(req.headers.authorization,'Bearer unrelated-tenant');res.setHeader('Set-Cookie',['sb-cbgpu-auth-token.0=poison; Domain=.cbgpu.com','own=ok; HttpOnly','sb-tenant-auth-token=tenant; HttpOnly']);res.end('upstream')});upstream.on('upgrade',(req,socket)=>{observed=req.headers.cookie||'';assert.equal(req.headers.authorization,'Bearer unrelated-tenant');socket.end('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: test\r\nSet-Cookie: cbgpu-auth=poison; Domain=.cbgpu.com\r\nSet-Cookie: own=ws; HttpOnly\r\nSet-Cookie: sb-tenant-auth-token=tenant; HttpOnly\r\n\r\n')});upstream.listen(0,'127.0.0.1');await once(upstream,'listening');const port=(upstream.address()as import('node:net').AddressInfo).port;try{await new Promise<void>((resolve,reject)=>{http.get({host:'127.0.0.1',port,headers:requestCookieBoundary({cookie:'sb-cbgpu-auth-token.0=secret; own=ok; sb-tenant-auth-token=tenant',authorization:'Bearer unrelated-tenant'})},response=>{assert.equal(observed,'own=ok; sb-tenant-auth-token=tenant');assert.deepEqual(responseCookieBoundary(response.headers,'tenant.server.cbgpu.com')['set-cookie'],['own=ok; HttpOnly','sb-tenant-auth-token=tenant; HttpOnly']);response.resume();response.on('end',resolve)}).on('error',reject)});await new Promise<void>((resolve,reject)=>{const req=http.request({host:'127.0.0.1',port,headers:requestCookieBoundary({cookie:'sb-cbgpu-auth-token.0=secret; own=ok; sb-tenant-auth-token=tenant',authorization:'Bearer unrelated-tenant',connection:'Upgrade',upgrade:'test'})});req.on('upgrade',(response,socket)=>{assert.equal(observed,'own=ok; sb-tenant-auth-token=tenant');assert.deepEqual(responseCookieBoundary(response.headers,'tenant.server.cbgpu.com')['set-cookie'],['own=ws; HttpOnly','sb-tenant-auth-token=tenant; HttpOnly']);socket.destroy();resolve()});req.on('error',reject);req.end()});}finally{upstream.closeAllConnections();await new Promise<void>(resolve=>upstream.close(()=>resolve()))}});
