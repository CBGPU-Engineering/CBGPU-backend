import{composeRuntimeInspector}from'./platform-cpu-compose-proof.mts';
import crypto from'node:crypto';import{PlatformCPUAuthority,platformCPUEnabled}from'./platform-cpu.mts';import{platformCPUJournal}from'./platform-cpu-journal.mts';
export function composeJobId(id:string,stamp:string){const b=crypto.createHash('sha256').update(id+'\0'+stamp).digest().subarray(0,16);b[6]=(b[6]&15)|0x80;b[8]=(b[8]&63)|0x80;const s=b.toString('hex');return s.slice(0,8)+'-'+s.slice(8,12)+'-'+s.slice(12,16)+'-'+s.slice(16,20)+'-'+s.slice(20)}
export function composePlatformController(db:any,seal:(v:unknown)=>string,unseal:(v:string)=>any){const inspector=composeRuntimeInspector(),authority=new PlatformCPUAuthority(),journal=platformCPUJournal(db,seal,unseal,authority);const context=(p:any)=>({school_id:p.allocation_school_id,project_kind:'compose' as const,project_id:p.id,owner_id:p.user_id,actor_id:p.deploy_requested_by,actor_session_id:p.deploy_actor_session_id});
 async function admission(p:any){if(!platformCPUEnabled()||p.env_vars?.CBGPU_DEPLOY_ENGINE!=='compose')return{decision:'DENY' as const};const actor=p.deploy_requested_by,role=actor===p.user_id?'owner':db.prepare("SELECT role FROM project_members WHERE resource_type='server' AND project_id=? AND user_id=?").get(p.id,actor)?.role;if(!role||role==='viewer')return{decision:'DENY' as const};try{await authority.seal(context(p));return{decision:'ALLOW' as const,project:p}}catch(e){return{decision:(e as any).status===403?'DENY' as const:'UNAVAILABLE' as const}}}
 async function begin(p:any){const a=context(p),job=composeJobId(p.id,p.deploy_requested_at),memory=String(p.memory_limit).match(/^(\d+(?:\.\d+)?)(g|m)$/i);if(!memory)throw Error('Invalid sealed Compose budget');const bytes=Math.ceil(Number(memory[1])*1024**(memory[2].toLowerCase()==='g'?3:2)),cpu=Math.ceil(Number(p.cpu_limit)*1000)+2,storage=Number(p.env_vars?.CBGPU_STORAGE_GB||40)*1024**3;const build=await journal.reserve(a,job,'compose_build',{cpu_millis:cpu,memory_bytes:bytes,storage_bytes:0}),runtime=await journal.reserve(a,job,'compose_runtime',{cpu_millis:cpu,memory_bytes:bytes,storage_bytes:storage});const instance=await inspector.instance(p.id,job);await journal.start(build,instance,a.actor_session_id);await journal.start(runtime,instance,a.actor_session_id);return{job,instance,build,runtime}}
 async function serving(p:any):Promise<'ALLOW'|'DENY'|'UNAVAILABLE'>{if(!platformCPUEnabled())return'DENY';const state=db.prepare('SELECT requested_at,result FROM compose_states WHERE project_id=?').get(p.id),stamp=state?.requested_at||p.deploy_requested_at;if(!stamp)return'DENY';const deployed=state?.result?JSON.parse(state.result):null,job=deployed?.platform_generation||composeJobId(p.id,stamp);const rows=journal.active().filter((r:any)=>r.project_kind==='compose'&&r.project_id===p.id&&r.job_id===job&&r.purpose==='compose_runtime');if(!rows.length)return'DENY';let unavailable=false;for(const row of rows){if(p.user_id!==row.private_state?.allocation?.owner_id||p.allocation_school_id!==row.school_id)return'DENY';try{const r=await journal.heartbeat(row);if(r.allowed===true){const proof=await inspector.inspect(p.id,row.job_id,row.instance_id);if(proof.present&&!proof.stopped)return'ALLOW';return'DENY'}if(r.stop_required===true)return'DENY'}catch{unavailable=true}}return unavailable?'UNAVAILABLE':'DENY'}
 async function completion(p:any,current:any){if(!current||current.user_id!==p.user_id||current.allocation_school_id!==p.allocation_school_id)return{decision:'DENY' as const};const job=composeJobId(p.id,p.deploy_requested_at),row=journal.active().find((r:any)=>r.project_kind==='compose'&&r.project_id===p.id&&r.job_id===job&&r.purpose==='compose_runtime');if(!row)return{decision:'DENY' as const};try{return{decision:(await journal.heartbeat(row)).allowed===true?'ALLOW' as const:'DENY' as const}}catch{return{decision:'UNAVAILABLE' as const}}}
 async function completed(p:any,success:boolean){if(!success)return;const job=composeJobId(p.id,p.deploy_requested_at);for(const row of journal.active().filter((r:any)=>r.project_kind==='compose'&&r.project_id===p.id&&r.job_id===job&&r.purpose==='compose_build')){await authority.call('release',{lease_id:row.private_state.lease.lease_id,lease_token:row.private_state.lease.lease_token,instance_id:row.instance_id,stopped:true,proof:'PROCESS_EXITED'});db.prepare("UPDATE platform_cpu_leases SET state='RELEASED' WHERE project_kind=? AND project_id=? AND job_id=? AND purpose=?").run('compose',p.id,job,'compose_build')}for(const old of journal.active().filter((r:any)=>r.project_kind==='compose'&&r.project_id===p.id&&r.purpose==='compose_runtime'&&r.job_id!==job)){const proof=await inspector.inspect(p.id,old.job_id,old.instance_id);if(proof.stopped)await journal.retireStopped(old,old.instance_id,'PROCESS_EXITED')}}
 async function stopped(p:any){for(const row of journal.active().filter((r:any)=>r.project_kind==='compose'&&r.project_id===p.id&&r.purpose==='compose_runtime')){const proof=await inspector.inspect(p.id,row.job_id,row.instance_id);if(proof.stopped)await journal.retireStopped(row,row.instance_id,'PROCESS_EXITED')}}
 return{admission,completion,begin,serving,completed,stopped,journal};}
