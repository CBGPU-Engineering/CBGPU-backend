import test from'node:test';import assert from'node:assert/strict';import{DatabaseSync}from'node:sqlite';import{queuedDeploymentAdmission,gateComposeAccess}from'./deployment-admission.mts';import{ownerResourceDecision}from'./resource-access.mts';
test('persisted actor loses queued execution immediately after membership or scope revocation',async()=>{const db=new DatabaseSync(':memory:');db.exec('CREATE TABLE jobs(id TEXT,project_id TEXT,requested_by TEXT);CREATE TABLE projects(id TEXT,owner TEXT,deleted INT);CREATE TABLE members(project_id TEXT,user_id TEXT,role TEXT);');db.prepare('INSERT INTO jobs VALUES(?,?,?)').run('job','project','editor');db.prepare('INSERT INTO projects VALUES(?,?,0)').run('project','owner');db.prepare('INSERT INTO members VALUES(?,?,?)').run('project','editor','editor');const loadProject=(id:string,actor:string)=>{const p=db.prepare('SELECT * FROM projects WHERE id=?').get(id)as any;const role=actor===p.owner?'owner':(db.prepare('SELECT role FROM members WHERE project_id=? AND user_id=?').get(id,actor)as any)?.role;if(!role)throw Object.assign(Error('revoked'),{status:403});return{...p,_role:role}};try{const job=db.prepare('SELECT * FROM jobs WHERE id=?').get('job')as any;assert.equal((await queuedDeploymentAdmission(job,{enforced:true,loadProject,decision:async()=> 'ALLOW'})).decision,'ALLOW');db.prepare('DELETE FROM members WHERE user_id=?').run('editor');assert.equal((await queuedDeploymentAdmission(job,{enforced:true,loadProject,decision:async()=> 'ALLOW'})).decision,'DENY');db.prepare('INSERT INTO members VALUES(?,?,?)').run('project','editor','editor');assert.equal((await queuedDeploymentAdmission(job,{enforced:true,loadProject,decision:async id=>id==='editor'?'DENY':'ALLOW'})).decision,'DENY');assert.equal((await queuedDeploymentAdmission({...job,requested_by:null},{enforced:true,legacyOwner:'owner',loadProject,decision:async()=> 'ALLOW'})).decision,'DENY')}finally{db.close()}});
test('authority outage is separate from a verified denial and never starts a queued worker',async()=>{const job={project_id:'p',requested_by:'owner'},loadProject=()=>({owner:'owner',_role:'owner'});assert.equal((await queuedDeploymentAdmission(job,{enforced:true,loadProject,decision:async()=> 'UNAVAILABLE'})).decision,'UNAVAILABLE');assert.equal((await queuedDeploymentAdmission(job,{enforced:true,loadProject:()=>{throw Error('database offline')},decision:async()=> 'ALLOW'})).decision,'UNAVAILABLE')});
test('existing route is withdrawn before denial is recorded, with no deletion or automatic restart',async()=>{for(const decision of['DENY','UNAVAILABLE']as const){let route=true,stopped=0,launched=0;const events:string[]=[];await gateComposeAccess({decision,previousDenied:false,newRequest:false,stopOnDenial:false},{withdraw:()=>{route=false;events.push('withdraw')},mark:state=>{assert.equal(route,false);events.push(state)},suspend:()=>{stopped++},allow:()=>{launched++}});assert.deepEqual(events,['withdraw',decision]);assert.equal(stopped,0);assert.equal(launched,0)}let allowed=false;await gateComposeAccess({decision:'ALLOW',previousDenied:true,newRequest:false,stopOnDenial:true},{withdraw:()=>{},mark:()=>{},suspend:()=>{},allow:()=>{allowed=true}});assert.equal(allowed,false)});
test('graceful suspend requires explicit policy, and restore requires a fresh manual request',async()=>{const events:string[]=[],effects={withdraw:()=>{events.push('withdraw')},mark:(s:string)=>{events.push(s)},suspend:()=>{events.push('graceful-stop-retain-volumes')},allow:()=>{events.push('new-authorized-request')}};await gateComposeAccess({decision:'DENY',previousDenied:false,newRequest:false,stopOnDenial:true},effects);assert.deepEqual(events,['withdraw','DENY','graceful-stop-retain-volumes']);events.length=0;await gateComposeAccess({decision:'ALLOW',previousDenied:true,newRequest:true,stopOnDenial:true},effects);assert.deepEqual(events,['ALLOW','new-authorized-request'])});
test('a later outage cannot erase a sticky revocation and silently restore a route',async()=>{let state='DENY',route=false;const effects={withdraw:()=>{route=false},mark:(value:string)=>{state=value},suspend:()=>{},allow:()=>{route=true}};await gateComposeAccess({decision:'UNAVAILABLE',previousDenied:state==='DENY',newRequest:false,stopOnDenial:false},effects);assert.equal(state,'DENY');await gateComposeAccess({decision:'ALLOW',previousDenied:state==='DENY',newRequest:false,stopOnDenial:false},effects);assert.equal(route,false)});
