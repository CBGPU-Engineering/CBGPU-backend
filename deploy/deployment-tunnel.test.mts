import test from'node:test';import assert from'node:assert/strict';import http from'node:http';import net from'node:net';import{once}from'node:events';import{upgradeDeployment,proxyDeploymentHTTP}from'./deployment-tunnel.mts';
const closed=(socket:any)=>Promise.race([new Promise(resolve=>socket.once('close',resolve)),new Promise((_,reject)=>{const timer=setTimeout(()=>reject(Error('revoked stream remained connected')),1500);timer.unref()})]);
test('real WebSocket tunnel authenticates before upgrade and closes existing sockets on revoke, outage or owner change',async()=>{let mode='allow',owner='private-owner-a',upgrades=0;const sockets=new Set<any>(),upstream=http.createServer();upstream.on('connection',socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket))});upstream.on('upgrade',(_req,socket)=>{upgrades++;socket.write('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n');socket.on('data',data=>socket.write(data))});upstream.listen(0,'127.0.0.1');await once(upstream,'listening');const targetPort=(upstream.address()as net.AddressInfo).port,resolve=async()=>{if(mode==='outage')throw Error('authority offline');return mode==='deny'?null:{port:targetPort,_project:'private-project',_owner:owner,_kind:'frontend'}};const options={intervalMs:20,headers:(h:any)=>h,responseHeaders:(h:any)=>h};const bridge=http.createServer();bridge.on('connection',socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket))});bridge.on('upgrade',(req,socket,head)=>void upgradeDeployment(req,socket,head,resolve,options));bridge.listen(0,'127.0.0.1');await once(bridge,'listening');const port=(bridge.address()as net.AddressInfo).port;const connect=async()=>{const client=net.connect(port,'127.0.0.1');sockets.add(client);await once(client,'connect');client.write('GET /socket HTTP/1.1\r\nHost: published.example.com\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n');const[data]=await once(client,'data');return{client,text:data.toString()}};
 try{mode='deny';const rejected=await connect();assert.match(rejected.text,/404/);assert.equal(upgrades,0);rejected.client.destroy();for(const change of['deny','outage','owner-change']){mode='allow';owner='private-owner-a';const {client,text}=await connect();assert.match(text,/101/);assert.doesNotMatch(text,/private-owner|private-project/);const ending=closed(client);if(change==='owner-change')owner='private-owner-b';else mode=change;await ending;assert.equal(client.destroyed,true)}assert.equal(upgrades,3)}finally{for(const socket of sockets)socket.destroy();bridge.closeAllConnections();upstream.closeAllConnections();await Promise.all([new Promise<void>(r=>bridge.close(()=>r())),new Promise<void>(r=>upstream.close(()=>r()))])}});
test('real long HTTP response is disconnected on authority outage without touching files or workloads',async()=>{let allowed=true;const sockets=new Set<any>(),upstream=http.createServer((_req,res)=>{res.writeHead(200,{'Content-Type':'text/event-stream'});res.write('data: initial\n\n');const timer=setInterval(()=>res.write('data: fixture\n\n'),10);res.on('close',()=>clearInterval(timer))});for(const server of[upstream])server.on('connection',socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket))});upstream.listen(0,'127.0.0.1');await once(upstream,'listening');const target={port:(upstream.address()as net.AddressInfo).port,_project:'private-id',_owner:'private-owner',_kind:'server'},bridge=http.createServer((req,res)=>proxyDeploymentHTTP(req,res,target,async()=>allowed?target:null,{intervalMs:20,headers:h=>h,responseHeaders:h=>h}));bridge.on('connection',socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket))});bridge.listen(0,'127.0.0.1');await once(bridge,'listening');try{const response=await new Promise<http.IncomingMessage>(resolve=>http.get({host:'127.0.0.1',port:(bridge.address()as net.AddressInfo).port},resolve));response.on('error',()=>{});await once(response,'data');const ending=closed(response);allowed=false;await ending;assert.equal(response.destroyed,true)}finally{for(const socket of sockets)socket.destroy();bridge.closeAllConnections();upstream.closeAllConnections();await Promise.all([new Promise<void>(r=>bridge.close(()=>r())),new Promise<void>(r=>upstream.close(()=>r()))])}});
