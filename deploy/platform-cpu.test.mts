import test from'node:test';import assert from'node:assert/strict';import{PlatformCPUAuthority,platformCPUEnabled,validateAllocation}from'./platform-cpu.mts';
const actor='11111111-1111-4111-8111-111111111111',session='22222222-2222-4222-8222-222222222222',project='33333333-3333-4333-8333-333333333333',job='44444444-4444-4444-8444-444444444444';
const allocation={school_id:'school-b',actor_id:actor,actor_session_id:session,owner_id:actor,project_kind:'frontend' as const,project_id:project};
test('new platform CPU mode defaults off and malformed flags cannot open it',()=>{assert.equal(platformCPUEnabled({}),false);assert.equal(platformCPUEnabled({CBGPU_CENTRAL_CPU_V1:'1'}),true);assert.equal(platformCPUEnabled({CBGPU_CENTRAL_CPU_V1:'true'}),true);assert.throws(()=>platformCPUEnabled({CBGPU_CENTRAL_CPU_V1:'yes'}));assert.throws(()=>validateAllocation({...allocation,actor_session_id:''}));assert.throws(()=>validateAllocation({...allocation,school_id:'../cbsh'}))});
test('durable lease client seals principal/school/budget and never releases on heartbeat loss',async()=>{const prior={flag:process.env.CBGPU_CENTRAL_CPU_V1,key:process.env.SERVICE_ROLE_KEY};process.env.CBGPU_CENTRAL_CPU_V1='1';process.env.SERVICE_ROLE_KEY='synthetic-private';try{const calls:any[]=[];let fail=false;const service=new PlatformCPUAuthority(async(url:any,opts:any)=>{assert.equal(String(url),'http://127.0.0.1:54321/rest/v1/rpc/cbgpu_platform_cpu_service');assert.equal(opts.redirect,'error');assert.equal(opts.headers.Authorization,'Bearer synthetic-private');const input=JSON.parse(opts.body);calls.push(input);if(fail)throw Error('authority down');return Response.json(input.action==='acquire'?{allowed:true,lease:{lease_id:job,lease_token:'a'.repeat(64),school_id:'school-b',purpose:'frontend_build',job_id:job,state:'RESERVED'}}:{allowed:true,ok:true})});const lease=await service.acquire(allocation,job,'frontend_build',{cpu_millis:2000,memory_bytes:2147483648,storage_bytes:0},'a'.repeat(64));assert.equal(calls[0].payload.actor_session_id,session);assert.equal(calls[0].payload.school_id,'school-b');await service.start(lease,'cbfront-build-'+job,session);fail=true;await assert.rejects(service.heartbeat(lease,'cbfront-build-'+job));assert.equal(calls.filter(c=>c.action==='release').length,0);fail=false;await assert.rejects(service.releaseStopped(lease,{runtime_ref:'x',runtime_absent:false,build_process_exited:true}as any));await service.releaseStopped(lease,{runtime_ref:'cbfront-build-'+job,runtime_absent:true,build_process_exited:true});assert.equal(calls.at(-1).action,'release')}finally{for(const[k,v]of[['CBGPU_CENTRAL_CPU_V1',prior.flag],['SERVICE_ROLE_KEY',prior.key]])if(v===undefined)delete process.env[k];else process.env[k]=v}});
