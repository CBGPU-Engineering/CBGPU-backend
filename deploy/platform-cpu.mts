import{deploymentBackendOrigin}from'./runtime-config.mts';
export type PlatformPurpose='frontend_build'|'frontend_runtime'|'compose_build'|'compose_runtime'|'latex_compile';
export type PlatformAllocation={school_id:string;actor_id:string;actor_session_id?:string|null;delegation_id?:string;delegation_token?:string;owner_id:string;project_kind:'frontend'|'compose'|'latex';project_id:string;execution_mode?:'UNASSIGNED_V1';never_executed?:true};
export type PlatformLease={lease_id:string;lease_token:string;state:'RESERVED'|'RUNNING'|'RECONCILE_REQUIRED'|'STORAGE_RETAINED';school_id:string;purpose:PlatformPurpose;job_id:string};
export function platformCPUEnabled(env:Record<string,string|undefined>=process.env){const value=env.CBGPU_CENTRAL_CPU_V1;if(![undefined,'','0','false','1','true'].includes(value))throw Error('Platform CPU configuration unavailable');return value==='1'||value==='true'}
const uuid=(s:unknown)=>typeof s==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(s);
export function validateAllocation(input:PlatformAllocation){if(!/^[-a-zA-Z0-9_]{1,100}$/.test(input.school_id)||!uuid(input.actor_id)||!(uuid(input.actor_session_id)||uuid(input.delegation_id)&&/^[a-f0-9]{64}$/.test(input.delegation_token||'')&&input.actor_id===input.owner_id)||!uuid(input.owner_id)||!['frontend','compose','latex'].includes(input.project_kind)||!(input.project_kind==='latex'?/^[a-f0-9]{24}$/i.test(input.project_id):uuid(input.project_id)))throw Error('Invalid sealed CPU allocation');return{...input}}
/** Private service adapter; no caller-provided endpoint, key, user fallback or TTL-based capacity release. */
export class PlatformCPUAuthority{
