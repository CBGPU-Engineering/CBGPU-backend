 async call(action:string,payload:Record<string,unknown>){if(!platformCPUEnabled())throw Object.assign(Error('Central CPU is not enabled'),{status:403});const key=process.env.SERVICE_ROLE_KEY;if(!key)throw Error('Central CPU authority unavailable');const response=await this.transport(deploymentBackendOrigin()+'/rest/v1/rpc/cbgpu_platform_cpu_service',{method:'POST',headers:{apikey:key,Authorization:'Bearer '+key,'Content-Type':'application/json'},body:JSON.stringify({action,payload}),redirect:'error',signal:AbortSignal.timeout(10000)});if(!response.ok)throw Object.assign(Error(response.status===403?'Central CPU permission denied':response.status===409?'Central CPU quota exhausted':'Central CPU authority unavailable'),{status:[403,409].includes(response.status)?response.status:503});const bytes=await response.arrayBuffer();if(bytes.byteLength>65536)throw Error('Invalid central CPU response');const value=JSON.parse(new TextDecoder().decode(bytes));if(!value||typeof value!=='object'||Array.isArray(value))throw Error('Invalid central CPU response');return value as Record<string,any>}
 async seal(allocation:PlatformAllocation){const out=await this.call('seal',validateAllocation(allocation));if(out.allowed!==true)throw Object.assign(Error('Central CPU allocation denied'),{status:403});return out}
 async acquire(allocation:PlatformAllocation,job_id:string,purpose:PlatformPurpose,budget:{cpu_millis:number;memory_bytes:number;storage_bytes:number},lease_nonce:string){validateAllocation(allocation);if(!/^[a-f0-9]{64}$/.test(lease_nonce))throw Error('Persisted private lease nonce required');if(!uuid(job_id)||!Number.isSafeInteger(budget.cpu_millis)||budget.cpu_millis<1||!Number.isSafeInteger(budget.memory_bytes)||budget.memory_bytes<1||!Number.isSafeInteger(budget.storage_bytes)||budget.storage_bytes<0)throw Error('Invalid central CPU reservation');const result=await this.call('acquire',{...allocation,job_id,purpose,...budget,lease_nonce,idempotency_key:job_id});if(result.allowed!==true)throw Object.assign(Error('Central CPU allocation denied'),{status:403});return this.lease({...result,lease_token:lease_nonce},allocation.school_id,purpose,job_id)}
 lease(result:Record<string,any>,school:string,purpose:PlatformPurpose,job:string):PlatformLease{const lease=result.lease||result;if(!uuid(lease.lease_id)||typeof lease.lease_token!=='string'||!/^[a-f0-9]{64}$/i.test(lease.lease_token)||lease.school_id!==school||lease.purpose!==purpose||lease.job_id!==job||!['RESERVED','RUNNING','RECONCILE_REQUIRED','STORAGE_RETAINED'].includes(lease.state))throw Error('Invalid central CPU lease');return lease}
 async start(lease:PlatformLease,runtime_ref:string,actor_session_id?:string|null){if(!/^(?:(?:cbfront-(?:build|run)-|cbgpu-latex-job-)[a-f0-9-]{24,80}|compose:[a-f0-9]{64}:[a-f0-9-]{36}:[a-f0-9-]{36})$/.test(runtime_ref))throw Error('Invalid managed runtime reference');const out=await this.call('start',{lease_id:lease.lease_id,lease_token:lease.lease_token,actor_session_id,instance_id:runtime_ref});if(out.allowed!==true)throw Object.assign(Error('Central CPU start denied'),{status:403});return out}
 async heartbeat(lease:PlatformLease,instance_id:string){return this.call('heartbeat',{lease_id:lease.lease_id,lease_token:lease.lease_token,instance_id})}
 /** Only after a controller has inspected the runtime absent; never use expiry/timeout alone. */
 async releaseStopped(lease:PlatformLease,proof:{runtime_ref:string;runtime_absent:true;build_process_exited:true}){if(proof.runtime_absent!==true||proof.build_process_exited!==true)throw Error('Stopped runtime proof required');return this.call('release',{lease_id:lease.lease_id,lease_token:lease.lease_token,instance_id:proof.runtime_ref,stopped:true,proof:'CONTAINER_ABSENT'})}
}
