/** Reviewed rollback adapter: explicit NEW authenticated reverse snapshots only; default path unchanged. */
import fs from'node:fs';import path from'node:path';import crypto from'node:crypto';
function privateFile(file:string){const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);const meta=fs.fstatSync(fd);if(!meta.isFile()||meta.uid!==process.getuid?.()||meta.mode&0o077){fs.closeSync(fd);throw Error('Reverse SQLite and manifest must be private operator-owned regular files')}return fd}
export function legacyDatabasePath(configured:string|undefined,fallback:string,authenticate:(sealed:string)=>Record<string,any>,expectedFingerprint?:string){if(configured===undefined)return fallback;if(!path.isAbsolute(configured)||configured.includes('\0')||configured.length>4096)throw Error('Explicit reverse SQLite path must be absolute');if(!/^[a-f0-9]{64}$/.test(expectedFingerprint||''))throw Error('Reviewed current reverse fingerprint required');let db:number|undefined,manifestFd:number|undefined;try{db=privateFile(configured);manifestFd=privateFile(configured+'.manifest.json');if(fs.fstatSync(manifestFd).size>1024*1024*1024)throw Error('Reverse manifest exceeds reviewed bound');const envelope=JSON.parse(fs.readFileSync(manifestFd,'utf8'));if(envelope.format!=='cbgpu-deploy-reverse-v1'||typeof envelope.sealed_manifest!=='string')throw Error('Unknown reverse manifest');const manifest=authenticate(envelope.sealed_manifest);if(manifest.source_fingerprint!==expectedFingerprint)throw Error('Stale reverse fingerprint; original database not selected');if(manifest.format!==1||manifest.native_data_root!==fs.realpathSync(path.dirname(fallback))||!/^[a-f0-9]{64}$/.test(manifest.sqlite_sha256||''))throw Error('Reverse source format or artifact-root proof differs');const hash=crypto.createHash('sha256'),bytes=Buffer.alloc(65536);let offset=0;for(;;){const read=fs.readSync(db,bytes,0,bytes.length,offset);if(!read)break;hash.update(bytes.subarray(0,read));offset+=read}if(hash.digest('hex')!==manifest.sqlite_sha256)throw Error('Reverse SQLite hash differs; original database not selected');return configured}finally{if(db!==undefined)fs.closeSync(db);if(manifestFd!==undefined)fs.closeSync(manifestFd)}}
