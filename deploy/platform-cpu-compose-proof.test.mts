import test from'node:test';import assert from'node:assert/strict';import{composeRuntimeInspector}from'./platform-cpu-compose-proof.mts';
const p='11111111-1111-4111-8111-111111111111',g='22222222-2222-4222-8222-222222222222';
test('retirement is exact node/project/generation and never a name-only or unknown-authority proof',async()=>{let running=true,forged=false,missing=false,offline=false;const inspector=composeRuntimeInspector(async args=>{if(offline)throw Error('Docker unavailable');if(args[0]==='info')return'synthetic-engine';if(args[0]==='ps')return'abcdefabcdef\n';if(args[0]==='inspect')return JSON.stringify([{Name:'/cbgpu-compose-'+p+'-app',Config:{Labels:{'com.docker.compose.project':'cbgpu-compose-'+p,'cbgpu.platform.project':forged?'foreign':p,...(missing?{}:{'cbgpu.platform.generation':g})}},State:{Running:running}}]);throw Error('Unexpected Docker command')});const instance=await inspector.instance(p,g);assert.equal((await inspector.inspect(p,g,instance)).stopped,false);running=false;assert.equal((await inspector.inspect(p,g,instance)).stopped,true);forged=true;await assert.rejects(inspector.inspect(p,g,instance));forged=false;missing=true;await assert.rejects(inspector.inspect(p,g,instance));missing=false;await assert.rejects(inspector.inspect(p,g,instance.replace('compose:','compose:foreign-')));offline=true;await assert.rejects(inspector.inspect(p,g,instance))});
