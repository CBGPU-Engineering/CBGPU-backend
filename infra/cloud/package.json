{
  "name": "@cbgpu/cloud-readiness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.js",
    "synth": "npm run build && cdk synth --no-lookups --no-version-reporting --path-metadata false --asset-metadata false",
    "prepare:context": "node scripts/prepare-context.mts",
    "validate:compose": "node scripts/validate-compose.mts",
    "test:container": "node scripts/test-container.mts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.278.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
