/** Package the static GUI without root, FUSE installation, or an unpinned runtime download. */
import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';
const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'),[binaryArg,outArg]=process.argv.slice(2);if(!binaryArg||!outArg)throw Error('Usage: node package-appimage.mts STATIC_BINARY OUTPUT_DIRECTORY');
const binary=path.resolve(binaryArg),out=path.resolve(outArg);await fs.mkdir(out,{recursive:true});const app=path.join(out,'CBGPU-Node-Setup.AppDir');await fs.mkdir(app,{recursive:true});
const cache=path.join(out,'.packaging-tools');await fs.mkdir(cache,{recursive:true,mode:0o700});
async function pinned(name:string,url:string,digest:string){const dest=path.join(cache,name);let bytes:Buffer;try{bytes=await fs.readFile(dest)}catch{const r=await fetch(url,{signal:AbortSignal.timeout(90000)});if(!r.ok)throw Error('Packaging dependency unavailable');bytes=Buffer.from(await r.arrayBuffer())}if(createHash('sha256').update(bytes).digest('hex')!==digest)throw Error('Packaging dependency checksum mismatch');await fs.writeFile(dest,bytes,{mode:0o700});return dest;}
const tool=await pinned('appimagetool-x86_64.AppImage','https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage','e8c1169c4af66c3184d7ee110713d4be04befe671fa358e2c1591ee840553b03');
const runtime=await pinned('runtime-x86_64','https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64','617aa77314d57c8b8e4fae9c3f0b35af7b30d5529cb69e98f64f92510ed98a46');
await fs.copyFile(binary,path.join(app,'AppRun'));await fs.chmod(path.join(app,'AppRun'),0o755);await fs.copyFile(path.join(root,'web/logo.svg'),path.join(app,'cbgpu-node-setup.svg'));
await fs.writeFile(path.join(app,'cbgpu-node-setup.desktop'),'[Desktop Entry]\nType=Application\nName=CBGPU Node Setup\nComment=Connect a school GPU server to CBGPU\nExec=AppRun\nIcon=cbgpu-node-setup\nTerminal=false\nCategories=System;\nStartupNotify=true\n');
await fs.copyFile(path.join(root,'../../..','LICENSE'),path.join(app,'LICENSE'));await fs.copyFile(path.join(root,'packaging/APPIMAGE-RUNTIME-LICENSE'),path.join(app,'APPIMAGE-RUNTIME-LICENSE'));
const output=path.join(out,'CBGPU-GPU-Setup-x86_64.AppImage');const result=spawnSync(tool,['--runtime-file',runtime,app,output],{env:{...process.env,ARCH:'x86_64',APPIMAGE_EXTRACT_AND_RUN:'1',SOURCE_DATE_EPOCH:process.env.SOURCE_DATE_EPOCH||'1794960000'},stdio:'inherit'});if(result.status!==0)throw Error('AppImage packaging failed');
const bytes=await fs.readFile(output);await fs.writeFile(path.join(out,'CBGPU-GPU-Setup-x86_64.AppImage.sha256'),createHash('sha256').update(bytes).digest('hex')+'  '+path.basename(output)+'\n');console.log(JSON.stringify({artifact:output,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')}));
