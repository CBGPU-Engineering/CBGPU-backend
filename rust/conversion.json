{
  "schema_version": 1,
  "target": "All CBGPU-owned non-UI service logic in Rust; persistent owned application state in PostgreSQL",
  "boundaries": [
    "Website React/Next.js UI and Flutter UI keep their current design. Only API proxy glue may remain in the frontend.",
    "User-deployed applications, notebook kernels, model weights, PostgreSQL, Docker, OS and GPU drivers are not user-authored CBGPU service code to rewrite.",
    "Compatibility forwarding does not count as a converted business API.",
    "No legacy component is removed until its complete contract, authorization, persistence, recovery and active-session drain tests pass."
  ],
  "services": [
    {
      "id": "operations-core",
      "contract": "Axum operational health and PostgreSQL audit",
      "sources": [
        "rust/crates/cbgpu-core"
      ],
      "status": "live",
      "data": "PostgreSQL"
    },
    {
      "id": "study-trigger",
      "contract": "Weekday timer trigger only; business logic is listed separately",
      "sources": [
        "rust/crates/cbgpu-core",
        "rust/deploy/cbgpu-study-auto.service"
      ],
      "status": "live",
      "data": "PostgreSQL"
    },
    {
      "id": "timetable-trigger",
      "contract": "Timer/cache-warming trigger only",
      "sources": [
        "rust/crates/cbgpu-core",
        "rust/deploy/cbgpu-timetable-refresh.service"
      ],
      "status": "live",
      "data": "PostgreSQL"
    },
    {
      "id": "frontend-build-worker",
      "contract": "Git clone, sandboxed build, Next runtime and static artifacts",
      "sources": [
        "rust/crates/cbgpu-front-worker",
        "rust/compat/worker-command.mts",
        "deploy/server.mts"
      ],
      "status": "live",
      "data": "filesystem",
      "activation": "Deployment supervisor release 9fad69d uses installed Rust binary; existing project, deployment and Compose state verified unchanged during handoff."
    },
    {
      "id": "deployment-ingress",
      "contract": "Streaming HTTP and upgraded TCP gateway; legacy business endpoints remain legacy",
      "sources": [
        "deploy/server.mts HTTP forwarding"
      ],
      "status": "implemented_not_active",
      "data": "none"
    },
    {
      "id": "deployment-control",
      "contract": "Projects, environment values, domains, permissions, queue and rollbacks",
      "sources": [
        "deploy/server.mts"
      ],
      "status": "not_started",
      "data": "SQLite -> PostgreSQL"
    },
    {
      "id": "compose-executor",
      "contract": "Validation, Docker builds, health failures, storage budgets and retained volumes",
      "sources": [
        "rust/crates/cbgpu-compose-worker",
        "deploy/compose-manager.mts"
      ],
      "status": "live",
      "data": "Named Docker volumes retained; existing control state remains under deployment-control migration",
      "activation": "Deployment supervisor release e611ab0 uses the exact-source Rust Compose binary; existing deployment and Compose state verified unchanged during handoff."
    },
    {
      "id": "careers",
      "contract": "Application forms, existing submissions, notification outbox and management",
      "sources": [
        "careers/server.py"
      ],
      "status": "implemented_not_active",
      "data": "PostgreSQL candidate; legacy SQLite remains authoritative until verified handoff",
      "rust_sources": [
        "rust/crates/cbgpu-careers"
      ]
    },
    {
      "id": "developer-portal",
      "contract": "Operational APIs, real PTY terminals and audit",
      "sources": [
        "developer/server.mts"
      ],
      "status": "not_started",
      "data": "SQLite -> PostgreSQL"
    },
    {
      "id": "gpu-controller",
      "contract": "Reservation enforcement and managed GPU container lifecycle",
      "sources": [
        "CBGPU-gpu-daemon"
      ],
      "status": "not_started",
      "data": "PostgreSQL"
    },
    {
      "id": "gpu-ssh-gateways",
      "contract": "Notebook HTTP/WebSocket and reservation-scoped SSH forwarding",
      "sources": [
        "gpu/server.mts",
        "gpu/ssh*"
      ],
      "status": "not_started",
      "data": "PostgreSQL"
    },
    {
      "id": "ai",
      "contract": "Private inference orchestration, streaming, jobs, OCR, models and keys",
      "sources": [
        "ai"
      ],
      "status": "not_started",
      "data": "SQLite -> PostgreSQL"
    },
    {
      "id": "materials",
      "contract": "Sharing, object access, uploads and range downloads",
      "sources": [
        "CBGPU-materials"
      ],
      "status": "live",
      "data": "Existing PostgreSQL metadata and caller RLS API; UUID file bytes and resumable reservations preserved",
      "rust_sources": [
        "https://github.com/CBGPU-Engineering/CBGPU-materials/tree/main/src"
      ],
      "validation": [
        "9 isolated transfer/storage contracts",
        "Rust formatting and Clippy",
        "Non-root read-only container readiness, authentication rejection and disabled-write smoke"
      ],
      "activation": "Rust is the sole writer on loopback port 8421. Legacy Python container is stopped and retained privately for rollback."
    },
    {
      "id": "latex",
      "contract": "Documents, collaborative edits, ZIP uploads, compilation and PDF delivery",
      "sources": [
        "CBGPU-latex"
      ],
      "status": "not_started",
      "data": "MongoDB -> PostgreSQL"
    },
    {
      "id": "robotics",
      "contract": "Robot registration, remote commands, map frames and safety state",
      "sources": [
        "CBGPU-robotics"
      ],
      "status": "not_started",
      "data": "PostgreSQL"
    },
    {
      "id": "mcp-cli",
      "contract": "Deployment/AI agent protocols and OS packaging including env tools",
      "sources": [
        "CBGPU-mcp",
        "CBGPU-agent"
      ],
      "status": "not_started",
      "data": "local private credentials / PostgreSQL"
    },
    {
      "id": "auth-data-storage",
      "contract": "Auth/Data API/Storage compatibility preserving existing sessions, RLS and paths",
      "sources": [
        "supabase auth/rest/storage integrations"
      ],
      "status": "not_started",
      "data": "PostgreSQL"
    },
    {
      "id": "operations-delivery",
      "contract": "Backups, restore tests, CI-gated delivery and alert outboxes",
      "sources": [
        "operations/backup.mts",
        "operations/worker.mts",
        "operations/delivery/agent.py"
      ],
      "status": "not_started",
      "data": "PostgreSQL / filesystem"
    }
  ],
