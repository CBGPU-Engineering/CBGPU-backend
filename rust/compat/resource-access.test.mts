import test from 'node:test';import assert from 'node:assert/strict';import {ownerCanExecute} from '../../deploy/resource-access.mts';
test('service execution oracle is default off and fails closed when enabled',async()=>{const old=process.env.CBGPU_ACCOUNT_V2,key=process.env.SERVICE_ROLE_KEY;try{delete process.env.CBGPU_ACCOUNT_V2;assert.equal(await ownerCanExecute('invalid'),true);process.env.CBGPU_ACCOUNT_V2='true';delete process.env.SERVICE_ROLE_KEY;assert.equal(await ownerCanExecute('00000000-0000-0000-0000-000000000001'),false);process.env.SERVICE_ROLE_KEY='synthetic';const owner='00000000-0000-0000-0000-000000000001';assert.equal(await ownerCanExecute(owner,(async()=>Response.json(false)) as typeof fetch),false);assert.equal(await ownerCanExecute(owner,(async()=>Response.json(true)) as typeof fetch),true);assert.equal(await ownerCanExecute(owner,(async()=>{throw Error('offline')}) as typeof fetch),false)}finally{if(old===undefined)delete process.env.CBGPU_ACCOUNT_V2;else process.env.CBGPU_ACCOUNT_V2=old;if(key===undefined)delete process.env.SERVICE_ROLE_KEY;else process.env.SERVICE_ROLE_KEY=key}});
