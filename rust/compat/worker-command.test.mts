import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {frontendWorkerCommand,composeWorkerCommand} from './worker-command.mts';
test('Rust is required and never silently falls back',t=>{const home=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-worker-mode-'));t.after(()=>fs.rmSync(home,{recursive:true,force:true}));const here='/trusted/deploy';assert.throws(()=>frontendWorkerCommand({home,here,mode:'legacy'}));assert.throws(()=>frontendWorkerCommand({home,here,mode:'rust'}));assert.throws(()=>frontendWorkerCommand({home,here,mode:'unknown'}));const dir=path.join(home,'.local/lib/cbgpu-rust/workers');fs.mkdirSync(dir,{recursive:true});const binary=path.join(dir,'cbgpu-front-worker');fs.writeFileSync(binary,'test',{mode:0o755});const spec=frontendWorkerCommand({home,here,mode:'rust'});assert.equal(spec.command,binary);assert.deepEqual(spec.args,[]);assert.equal(spec.implementation,'rust');});

test('Compose requires an executable Rust worker',t=>{const home=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-compose-mode-'));t.after(()=>fs.rmSync(home,{recursive:true,force:true}));assert.throws(()=>composeWorkerCommand({home}));assert.throws(()=>composeWorkerCommand({home,mode:'legacy'}));const folder=path.join(home,'.local/lib/cbgpu-rust/workers');fs.mkdirSync(folder,{recursive:true});const binary=path.join(folder,'cbgpu-compose-worker');fs.writeFileSync(binary,'fixture',{mode:0o600});assert.throws(()=>composeWorkerCommand({home}));fs.chmodSync(binary,0o755);assert.equal(composeWorkerCommand({home}).command,binary);});
