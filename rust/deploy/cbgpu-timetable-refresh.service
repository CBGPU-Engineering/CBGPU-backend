[Unit]
Description=CBGPU Rust timetable cache refresh
After=cbgpu-frontend.service
[Service]
Type=oneshot
ExecStart=%h/.local/lib/cbgpu-rust/current/cbgpu-core timetable-refresh
EnvironmentFile=%h/.config/cbgpu/rust-core.env
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
TasksMax=32
