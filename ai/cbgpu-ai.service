# Review-only native candidate. Installing this file never performs data migration.
[Unit]
Description=CBGPU native local AI API and reservation scheduler
After=network.target
ConditionPathExists=%h/.config/cbgpu/ai-native-reviewed

[Service]
Type=simple
Environment=CBGPU_ACCOUNT_V2=0
Environment=CBGPU_MULTISCHOOL_V1=0
EnvironmentFile=%h/.config/cbgpu/ai-native.env
ExecStart=%h/.local/share/cbgpu-native-ai/bin/cbgpu-ai
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
