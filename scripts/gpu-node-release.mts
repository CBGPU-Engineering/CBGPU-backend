/** Prepare public release artifacts only. No credentials, host paths or runtime configuration. */
import fs from'node:fs';
import path from'node:path';
import{createHash}from'node:crypto';
import{execFileSync}from'node:child_process';
import{fileURLToPath}from'node:url';
const repository='https://github.com/CBGPU-Engineering/CBGPU-backend';
const sha=(bytes:Buffer|string)=>createHash('sha256').update(bytes).digest('hex');
export function reviewedTag(value:string){if(!/^gpu-node-v\d+\.\d+\.\d+-(?:alpha|beta|rc)\.\d+$/.test(value))throw Error('Use an explicit gpu-node-vX.Y.Z-beta.N prerelease tag');return value}
function revision(value:string){if(!/^[a-f0-9]{40}$/.test(value))throw Error('An exact source commit is required');return value}
function regular(file:string){const stat=fs.lstatSync(file);if(!stat.isFile()||stat.isSymbolicLink()||stat.size<1||stat.size>64*1024*1024)throw Error('Invalid release artifact');return fs.readFileSync(file)}
function onlyFiles(dir:string,expected:string[]){const stat=fs.lstatSync(dir);if(!stat.isDirectory()||stat.isSymbolicLink())throw Error("Artifact directory must not be a link");if(JSON.stringify(fs.readdirSync(dir).sort())!==JSON.stringify([...expected].sort()))throw Error('Unexpected artifact files; refusing to package private or unrelated data')}
function elf(bytes:Buffer){if(bytes.length<64||bytes.subarray(0,4).toString('hex')!=='7f454c46'||bytes[4]!==2||bytes[5]!==1||bytes.readUInt16LE(18)!==62)throw Error('Expected a Linux AMD64 ELF')}
export function nodeArtifact(binary:string,out:string,source:string){revision(source);const bytes=regular(binary);elf(bytes);const dynamic=execFileSync('readelf',['-d',binary],{encoding:'utf8'});if(/\((?:NEEDED|RPATH|RUNPATH)\)/.test(dynamic))throw Error('Node binary must be static without runtime search paths');if(fs.existsSync(out)&&(fs.lstatSync(out).isSymbolicLink()||fs.readdirSync(out).length))throw Error('Artifact output must be empty');fs.mkdirSync(out,{recursive:true});const name='cbgpu-node-linux-x86_64';fs.writeFileSync(path.join(out,name),bytes,{mode:0o755});fs.writeFileSync(path.join(out,name+'.sha256'),sha(bytes)+'  '+name+'\n');fs.writeFileSync(path.join(out,'node-build.json'),JSON.stringify({schema_version:1,source_revision:source,sha256:sha(bytes),size:bytes.length,static_musl:true},null,2)+'\n')}
export function releaseBundle(input:string,out:string,source:string,tag:string,runUrl:string,root=process.cwd()){
 revision(source);reviewedTag(tag);if(!/^https:\/\/github\.com\/CBGPU-Engineering\/CBGPU-backend\/actions\/runs\/\d+$/.test(runUrl))throw Error('Invalid build provenance URL');
 const definitions=[{folder:'cbgpu-school-node-linux-x86_64',name:'cbgpu-node-linux-x86_64',component:'school-node',platform:'linux-x86_64'},{folder:'cbgpu-node-setup-linux-x86_64',name:'CBGPU-GPU-Setup-x86_64.AppImage',component:'setup-gui',platform:'linux-x86_64'},{folder:'cbgpu-node-setup-windows-x86_64',name:'CBGPU-GPU-Setup-x86_64.exe',component:'setup-gui',platform:'windows-x86_64'}];
 onlyFiles(input,definitions.map(v=>v.folder));const prepared=definitions.map(a=>{const dir=path.join(input,a.folder);onlyFiles(dir,[a.name,a.name+'.sha256',...(a.component==='school-node'?['node-build.json']:[])]);const bytes=regular(path.join(dir,a.name)),digest=sha(bytes),declared=regular(path.join(dir,a.name+'.sha256')).toString('utf8').trim();if(declared!==digest+'  '+a.name)throw Error('Artifact checksum mismatch');if(a.platform==='linux-x86_64')elf(bytes);else if(bytes.subarray(0,2).toString()!=='MZ')throw Error('Expected Windows executable');if(a.component==='school-node'){const build=JSON.parse(regular(path.join(dir,'node-build.json')).toString('utf8'));if(build.source_revision!==source||build.sha256!==digest||build.size!==bytes.length||build.static_musl!==true)throw Error('Node source provenance mismatch')}
 return {name:a.name,component:a.component,platform:a.platform,sha256:digest,size:bytes.length,source_repository:repository,source_revision:source,bytes};});
 if(fs.existsSync(out)&&(fs.lstatSync(out).isSymbolicLink()||fs.readdirSync(out).length))throw Error('Release output must be empty');
 fs.mkdirSync(out,{recursive:true});for(const a of prepared)fs.writeFileSync(path.join(out,a.name),a.bytes,{mode:0o644});
 const files=['LICENSE','NOTICE','THIRD_PARTY_NOTICES.md'];for(const name of files)fs.writeFileSync(path.join(out,name),regular(path.join(root,name)));
 fs.writeFileSync(path.join(out,'APPIMAGE-RUNTIME-LICENSE'),regular(path.join(root,'rust/crates/cbgpu-node-setup/packaging/APPIMAGE-RUNTIME-LICENSE')));
 const provenance={schema_version:1,release:tag,release_target_revision:source,artifacts:prepared.map(({bytes,...a})=>a),verification:{ci_run_url:runUrl,node_unit_and_contract_tests:true,node_static_elf_inspected:true,actual_source_sandbox_cpu:true,actual_cpu_kernel_json:true,actual_cpu_kernel_v1_binary:true,gui_native_linux_windows_tests:true,windows_static_c_runtime_import_guard:true,physical_gpu_passthrough_verified:false,windows_wsl_installation_validated:false,windows_gpu_installation_enabled:false},privacy:{credentials_included:false,local_build_paths_included:false}};
 fs.writeFileSync(path.join(out,'PROVENANCE.json'),JSON.stringify(provenance,null,2)+'\n');
 const notes=`# CBGPU GPU Node & Setup — ${tag}\n\nAn optional Rust school GPU connector and desktop setup helper. Existing GPU controllers are not replaced or restarted by downloading these packages.\n\n- **Ubuntu x86_64:** AppImage setup GUI or static cbgpu-node-linux-x86_64 connector.\n- **Windows x86_64:** EXE setup interface and environment checks. **GPU installation remains disabled; Windows/WSL installation and boot persistence are not validated.** There is no native Windows GPU daemon in this package.\n\nPrepare an existing NVIDIA driver, Docker access and NVIDIA Container Toolkit on the Ubuntu GPU server. Notebook execution uses the approved CUDA 12.8 image and must pass actual GPU device checks on that server. Prepare the image before issuing a ten-minute private enrollment from school administration. No driver, root-permission or Docker-group changes are made by the helper.\n\nOpen the Linux helper, explicitly check the environment, import the private enrollment/policy file and confirm installation. Do not paste enrollment credentials into chat, repositories or shell arguments. Headless servers can use the static connector CLI. The AppImage needs executable permission; extract-and-run mode can be used when FUSE is unavailable.\n\nDefault notebook limits: 2 CPU cores, 8 GiB RAM, 1 GiB temporary workspace; 16 GiB host RAM is recommended. Containers have no external network or published ports. Save important files before stopping the notebook or its reservation expires. School resource permission and successful runtime checks are required; inventory enrollment alone does not grant compute access or GPU sharing.\n\n## Verification\n\n[This package run](${runUrl}) performs node unit/contract tests, the actual source-generated Jupyter sandbox with HTTP and both kernel protocols on CPU only, native Linux/Windows GUI tests, static ELF checks and the Windows CRT import guard. **Physical GPU passthrough and actual Windows/WSL installation are not validated by hosted CI.** Each server must pass its own device/image checks before resources become reservable.\n\nAll three binaries in this automated release are built from [${source}](${repository}/tree/${source}). See PROVENANCE.json and SHA256SUMS for exact files and hashes. Release assets contain no credentials, private runtime configuration or build paths.\n\nCBGPU source is Apache-2.0. Included license/notice files cover the distribution; the AppImage runtime retains its separate MIT license. Third-party container images are not bundled and retain their own licenses.\n`;
 fs.writeFileSync(path.join(out,'RELEASE-NOTES.md'),notes);
 const names=fs.readdirSync(out).sort();for(const name of['PROVENANCE.json','RELEASE-NOTES.md'])if(/\/home\/|\/tmp\/|gpuenr_[a-f0-9]{64}|\"token\"\s*:|private_key|service_role/i.test(fs.readFileSync(path.join(out,name),'utf8')))throw Error('Private data in public metadata');
 fs.writeFileSync(path.join(out,'SHA256SUMS'),names.map(name=>sha(regular(path.join(out,name)))+'  '+name).join('\n')+'\n');return fs.readdirSync(out).sort();
}
if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){
 const [mode,...args]=process.argv.slice(2);
 if(mode==='resolve'){
  const tag=reviewedTag(process.env.RELEASE_TAG||''),source=revision(execFileSync('git',['rev-parse','--verify','refs/tags/'+tag+'^{commit}'],{encoding:'utf8'}).trim());if(!process.env.GITHUB_OUTPUT)throw Error('GitHub output unavailable');fs.appendFileSync(process.env.GITHUB_OUTPUT,'tag='+tag+'\nsource='+source+'\n');
 }else if(mode==='node')nodeArtifact(args[0],args[1],process.env.RELEASE_SOURCE_SHA||'');
 else if(mode==='bundle')console.log(JSON.stringify({staged:true,files:releaseBundle(args[0],args[1],process.env.RELEASE_SOURCE_SHA||'',process.env.RELEASE_TAG||'',process.env.RELEASE_RUN_URL||'')}));
 else throw Error('Expected resolve, node or bundle mode');
}
