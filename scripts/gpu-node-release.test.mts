import test from'node:test';
import assert from'node:assert/strict';
import fs from'node:fs';
import os from'node:os';
import path from'node:path';
import{createHash}from'node:crypto';
import{reviewedTag,releaseBundle}from'./gpu-node-release.mts';
const source='a'.repeat(40),tag='gpu-node-v0.1.0-beta.2',run='https://github.com/CBGPU-Engineering/CBGPU-backend/actions/runs/123';
const hash=(bytes:Buffer|string)=>createHash('sha256').update(bytes).digest('hex');
function fixture(){
 const root=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-release-fixture-')),input=path.join(root,'input'),out=path.join(root,'out');fs.mkdirSync(input);
 const binaries=[['cbgpu-school-node-linux-x86_64','cbgpu-node-linux-x86_64'],['cbgpu-node-setup-linux-x86_64','CBGPU-GPU-Setup-x86_64.AppImage'],['cbgpu-node-setup-windows-x86_64','CBGPU-GPU-Setup-x86_64.exe']];
 for(const[folder,name]of binaries){const bytes=Buffer.alloc(96);if(name.endsWith('.exe'))bytes.write('MZ');else{bytes.write('\x7fELF');bytes[4]=2;bytes[5]=1;bytes.writeUInt16LE(62,18)}const dir=path.join(input,folder);fs.mkdirSync(dir);fs.writeFileSync(path.join(dir,name),bytes);fs.writeFileSync(path.join(dir,name+'.sha256'),hash(bytes)+'  '+name+'\n');if(folder.includes('school-node'))fs.writeFileSync(path.join(dir,'node-build.json'),JSON.stringify({source_revision:source,sha256:hash(bytes),size:bytes.length,static_musl:true}));}
 for(const name of['LICENSE','NOTICE','THIRD_PARTY_NOTICES.md'])fs.writeFileSync(path.join(root,name),'synthetic public license\n');const licenses=path.join(root,'rust/crates/cbgpu-node-setup/packaging');fs.mkdirSync(licenses,{recursive:true});fs.writeFileSync(path.join(licenses,'APPIMAGE-RUNTIME-LICENSE'),'synthetic MIT\n');return{root,input,out,clean:()=>fs.rmSync(root,{recursive:true,force:true})};
}
test('only explicit prerelease tags are accepted',()=>{assert.equal(reviewedTag(tag),tag);for(const bad of['latest','v0.1.0','gpu-node-v0.1.0','gpu-node-v0.1.0-beta.2\nextra','../gpu-node-v0.1.0-beta.2','gpu-node-v0.1.0-beta.2;echo'])assert.throws(()=>reviewedTag(bad))});
test('bundle preserves verified bytes, exact provenance and public-only allowlist',()=>{const f=fixture();try{const files=releaseBundle(f.input,f.out,source,tag,run,f.root);assert.equal(files.length,10);assert.ok(files.includes('SHA256SUMS'));const provenance=JSON.parse(fs.readFileSync(path.join(f.out,'PROVENANCE.json'),'utf8'));assert.equal(provenance.artifacts.length,3);assert.ok(provenance.artifacts.every((a:any)=>a.source_revision===source&&!('path'in a)&&!('bytes'in a)));assert.equal(provenance.verification.windows_gpu_installation_enabled,false);assert.equal(provenance.verification.physical_gpu_passthrough_verified,false);for(const name of['PROVENANCE.json','RELEASE-NOTES.md'])assert.ok(!fs.readFileSync(path.join(f.out,name),'utf8').includes(f.root));const sums=fs.readFileSync(path.join(f.out,'SHA256SUMS'),'utf8').trim().split('\n');assert.equal(sums.length,9);for(const line of sums){const[digest,name]=line.split('  ');assert.equal(hash(fs.readFileSync(path.join(f.out,name))),digest)}assert.throws(()=>releaseBundle(f.input,f.out,source,tag,run,f.root),/must be empty/)}finally{f.clean()}});
test('unexpected private files and wrong hashes fail before writing a release',()=>{for(const mutation of['private','checksum','source','symlink']){const f=fixture();try{const node=path.join(f.input,'cbgpu-school-node-linux-x86_64');if(mutation==='private')fs.writeFileSync(path.join(node,'private.env'),'must never be bundled');if(mutation==='checksum')fs.writeFileSync(path.join(node,'cbgpu-node-linux-x86_64.sha256'),'0'.repeat(64)+'  cbgpu-node-linux-x86_64\n');if(mutation==='source'){const p=path.join(node,'node-build.json'),v=JSON.parse(fs.readFileSync(p,'utf8'));v.source_revision='b'.repeat(40);fs.writeFileSync(p,JSON.stringify(v))}if(mutation==='symlink'){const p=path.join(node,'cbgpu-node-linux-x86_64');fs.renameSync(p,p+'.original');fs.symlinkSync(p+'.original',p);fs.unlinkSync(p+'.original');}assert.throws(()=>releaseBundle(f.input,f.out,source,tag,run,f.root));assert.equal(fs.existsSync(f.out),false)}finally{f.clean()}}});
test('source and provenance URL cannot inject private or cross-repository data',()=>{const f=fixture();try{assert.throws(()=>releaseBundle(f.input,f.out,'../private',tag,run,f.root));assert.throws(()=>releaseBundle(f.input,f.out,source,tag,'https://example.invalid/run',f.root));assert.equal(fs.existsSync(f.out),false)}finally{f.clean()}});
test('resolve records the exact commit behind a validated tag without publishing or moving it',async()=>{const{execFileSync}=await import('node:child_process');const{fileURLToPath}=await import('node:url');const dir=fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-release-ref-'));try{execFileSync('git',['init','-q'],{cwd:dir});execFileSync('git',['-c','user.name=CBGPU test','-c','user.email=test@example.invalid','commit','--allow-empty','-qm','Synthetic source'],{cwd:dir});const commit=execFileSync('git',['rev-parse','HEAD'],{cwd:dir,encoding:'utf8'}).trim();execFileSync('git',['tag',tag,commit],{cwd:dir});const output=path.join(dir,'output');execFileSync(process.execPath,[fileURLToPath(new URL('./gpu-node-release.mts',import.meta.url)),'resolve'],{cwd:dir,env:{...process.env,RELEASE_TAG:tag,GITHUB_OUTPUT:output}});assert.equal(fs.readFileSync(output,'utf8'),'tag='+tag+'\nsource='+commit+'\n');assert.equal(execFileSync('git',['rev-parse',tag],{cwd:dir,encoding:'utf8'}).trim(),commit)}finally{fs.rmSync(dir,{recursive:true,force:true})}});
