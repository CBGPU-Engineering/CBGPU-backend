import {requestCookieBoundary,responseCookieBoundary} from '../deploy/cookie-boundary.mts';
import http from 'node:http';import fs from 'node:fs';import {execFile} from 'node:child_process';import {promisify} from 'node:util';import path from 'node:path';
const legacyPortRaw=process.env.CBGPU_GPU_LEGACY_PORT||'3500';if(!/^[1-9][0-9]{3,4}$/.test(legacyPortRaw)||Number(legacyPortRaw)>65535)throw new Error('CBGPU_GPU_LEGACY_PORT must be a numeric port 1024–65535');const legacyPort=Number(legacyPortRaw);if(legacyPort<1024)throw new Error('CBGPU_GPU_LEGACY_PORT must be 1024–65535');
const run=promisify(execFile),starter=process.env.CBGPU_GPU_PUBLIC_STARTER;const upstreams=new Map();let busy=false;
function nativeStarter(file:string){if(!path.isAbsolute(file)||!fs.statSync(file).isFile())return false;const handle=fs.openSync(file,'r');try{const magic=Buffer.alloc(4);return fs.readSync(handle,magic,0,4,0)===4&&magic.equals(Buffer.from([0x7f,0x45,0x4c,0x46]));}finally{fs.closeSync(handle);}}
if(starter&&!nativeStarter(starter))throw new Error('CBGPU_GPU_PUBLIC_STARTER must be a trusted absolute native ELF');
async function reconcile(){if(!starter){upstreams.clear();return}if(busy)return;busy=true;try{for(let n=1;n<=4;n++){const container='jupiterhub_gpu'+n;try{const {stdout}=await run('docker',['inspect','--format','{{.State.Running}} {{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}',container],{timeout:3000});const [running,ip]=stdout.trim().split(' ');if(running!=='true'||!/^172\.\d+\.\d+\.\d+$/.test(ip)){upstreams.delete(String(n));continue}if(!starter){upstreams.delete(String(n));continue}const {stdout:prepared}=await run(starter,[String(n),...(process.env.CBGPU_GPU_PUBLIC_STARTER_APPLY==='1'?['--apply']:[])],{timeout:12000,maxBuffer:4096});const ready=JSON.parse(prepared);if(ready.gpu!==n||ready.ip!==ip||ready.ready!==true){upstreams.delete(String(n));continue}upstreams.set(String(n),ip)}catch{upstreams.delete(String(n))}}}finally{busy=false}}
function destination(req){if(!['gpu.cbgpu.com','127.0.0.1','localhost'].includes((req.headers.host||'').split(':')[0]))return null;const n=req.url.match(/^\/([1-4])(?:\/|\?|$)/)?.[1],ip=upstreams.get(n);return ip?{hostname:ip,port:8889,path:req.url,method:req.method,headers:requestCookieBoundary({...req.headers,host:'gpu.cbgpu.com','x-forwarded-host':'gpu.cbgpu.com','x-forwarded-proto':'https','x-forwarded-for':req.headers['cf-connecting-ip']||req.socket.remoteAddress})}:null}
const server=http.createServer((req,res)=>{res.setHeader('X-Robots-Tag','noindex, nofollow');res.setHeader('Strict-Transport-Security','max-age=31536000');res.setHeader('Cache-Control','no-store');if(req.url==='/'){res.writeHead(302,{Location:'https://cbgpu.com/dashboard'});res.end();return}if(/^\/[1-4]$/.test(req.url)){res.writeHead(308,{Location:req.url+'/'});res.end();return}const target=destination(req);if(!target){res.writeHead(503,{'Content-Type':'text/plain'});res.end('Notebook is temporarily unavailable.');return}const proxy=http.request(target,response=>{res.writeHead(response.statusCode||502,responseCookieBoundary(response.headers,'gpu.cbgpu.com'));response.pipe(res)});proxy.on('error',()=>{if(!res.headersSent){res.writeHead(502);res.end('Notebook is starting. Please retry shortly.')}else res.destroy()});req.on('aborted',()=>proxy.destroy());req.pipe(proxy)});
